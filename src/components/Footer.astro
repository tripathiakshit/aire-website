---
const platform = [
  { href: '/technology', label: 'Technology' },
  { href: '/methodology', label: 'Living Methodology' },
  { href: '/council', label: 'The AiRE Council' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/publications', label: 'Blogs & Publications' },
];
const doors = [
  { href: '/explorer', label: 'For miners' },
  { href: '/government', label: 'For governments' },
  { href: '/investor', label: 'For investors' },
];
const engage = [
  { href: '/engage', label: 'Get the 48-Hour Prospect Brief' },
  { href: '/contact#cal-inline-embed', label: 'Book a call' },
  { href: 'mailto:info@geoexplorationllc.com', label: 'info@geoexplorationllc.com' },
];
---

<footer class="bg-ink text-canvas/80">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 md:gap-10">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <p class="font-fraunces text-2xl font-semibold text-canvas">Ai<span class="text-cage-gold">R</span>E</p>
        <p class="mt-1 text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-canvas/50">AI Resource Exploration</p>
        <p class="mt-4 text-sm leading-relaxed text-canvas/60">
          Subsurface intelligence that evolves with the science.<br />Your data. Today&rsquo;s tech. Tomorrow&rsquo;s targets.
        </p>
        <a
          href="https://www.linkedin.com/in/amit-tripathi-b7a5567/"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block text-xs text-canvas/50 transition-colors hover:text-canvas">LinkedIn: Dr. Amit Tripathi ↗</a
        >
      </div>

      <div>
        <h4 class="mb-4 text-xs font-semibold uppercase tracking-[0.15em] text-cage-gold-soft">Platform</h4>
        <ul class="space-y-2.5">
          {platform.map((l) => (
            <li><a href={l.href} class="text-sm text-canvas/60 transition-colors hover:text-canvas">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="mb-4 text-xs font-semibold uppercase tracking-[0.15em] text-cage-gold-soft">Doors</h4>
        <ul class="space-y-2.5">
          {doors.map((l) => (
            <li><a href={l.href} class="text-sm text-canvas/60 transition-colors hover:text-canvas">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="mb-4 text-xs font-semibold uppercase tracking-[0.15em] text-cage-gold-soft">Engage</h4>
        <ul class="space-y-2.5">
          {engage.map((l) => (
            <li><a href={l.href} class="text-sm text-canvas/60 transition-colors hover:text-canvas">{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Corporate / statutory disclaimer (preserved) -->
    <p class="mt-10 max-w-4xl text-[0.7rem] leading-relaxed text-canvas/40">
      AI Resource Exploration Private Limited (AiRE) is the operating entity, registered in India. AiRE was renamed from
      MPXG Exploration Private Limited by Special Resolution dated 02 January 2024 (Board Resolution 27 December 2023).
      CIN U74999TG2017PTC115998. PAN AAKCM9266D. Statutory transitions (PAN re-issue, GST trade-name amendment, Udyam
      re-registration in the AiRE name) are complete. GeoExploration LLC (Florida, est. 2012) is dormant; all active
      business operates through AiRE.
    </p>
  </div>

  <div class="border-t border-ink-2">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-4 py-4 text-xs text-canvas/45 sm:flex-row sm:px-6 lg:px-8">
      <span>© {new Date().getFullYear()} AI Resource Exploration Private Limited (AiRE). All rights reserved.</span>
      <span>Built on field truth, peer-reviewed science and 220+ regression tests.</span>
    </div>
  </div>
</footer>
