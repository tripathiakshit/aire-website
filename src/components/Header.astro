---
import { Menu, X, Sun, Moon } from 'lucide-astro';

const pathname = Astro.url.pathname;
const navLinks = [
  { href: '/technology', label: 'Technology' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/projects', label: 'Projects' },
  { href: '/publications', label: 'Publications' },
  { href: '/council', label: 'AiRE Council' },
  { href: '/methodology', label: 'Methodology' },
];
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-line bg-canvas/90 backdrop-blur-md transition-shadow dark:border-ink-2 dark:bg-ink/90"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <!-- Brand wordmark -->
    <a href="/" class="flex items-baseline gap-2 shrink-0">
      <span class="font-fraunces text-2xl font-semibold tracking-tight text-ink dark:text-canvas"
        >Ai<span class="text-cage-gold">R</span>E</span
      >
      <span class="hidden text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-text-soft sm:inline"
        >AI Resource Exploration</span
      >
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`px-3 py-2 text-sm font-medium transition-colors ${
            isActive(link.href)
              ? 'text-copper dark:text-copper-soft'
              : 'text-text-soft hover:text-ink dark:hover:text-canvas'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/engage"
        class="ml-2 rounded-md bg-cage-gold px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-cage-gold-deep"
      >
        Get the 48-Hour Prospect Brief
      </a>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="ml-2 inline-flex h-9 w-9 items-center justify-center rounded-md border border-line text-text-soft transition-colors hover:border-copper hover:text-ink dark:border-ink-2 dark:hover:text-canvas"
      >
        <span class="hidden dark:inline"><Sun size={17} /></span>
        <span class="inline dark:hidden"><Moon size={17} /></span>
      </button>
    </nav>

    <!-- Mobile controls -->
    <div class="flex items-center gap-1 lg:hidden">
      <button
        id="theme-toggle-mobile"
        type="button"
        aria-label="Toggle dark mode"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-line text-text-soft dark:border-ink-2"
      >
        <span class="hidden dark:inline"><Sun size={17} /></span>
        <span class="inline dark:hidden"><Moon size={17} /></span>
      </button>
      <button
        id="mobile-menu-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-ink hover:bg-canvas-alt dark:text-canvas dark:hover:bg-ink-2"
      >
        <span id="menu-icon-open"><Menu size={20} /></span>
        <span id="menu-icon-close" class="hidden"><X size={20} /></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu (height animated via global.css) -->
  <div id="mobile-menu" class="border-t border-line bg-canvas lg:hidden dark:border-ink-2 dark:bg-ink">
    <nav class="flex flex-col gap-1 px-4 py-3" aria-label="Mobile">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`rounded px-3 py-2.5 text-sm font-medium ${
            isActive(link.href) ? 'bg-canvas-alt text-copper dark:bg-ink-2' : 'text-text-soft hover:text-ink dark:hover:text-canvas'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a href="/engage" class="mt-2 rounded-md bg-cage-gold px-4 py-3 text-center text-sm font-semibold text-white">
        Get the 48-Hour Prospect Brief
      </a>
    </nav>
  </div>
</header>

<script>
  // Header scroll shadow
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('shadow-md', window.scrollY > 8);
  }, { passive: true });

  // Mobile menu
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open');
    iconOpen?.classList.toggle('hidden', !!open);
    iconClose?.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  // Dark-mode toggle (persisted; data-theme on <html>)
  function flipTheme() {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('aire-theme', next); } catch (e) {}
  }
  document.getElementById('theme-toggle')?.addEventListener('click', flipTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', flipTheme);
</script>
