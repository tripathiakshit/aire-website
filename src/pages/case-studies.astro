---
import V5Layout from '../layouts/V5Layout.astro';
const title = "Case Studies - with vs without CAGE-IN, on real ground | AiRE";
const description = "Documented AiRE case studies: the conventional read versus what CAGE-IN found, on real Copper-Gold Porphyry, Greenfield Nickel, Skarn and Epithermal Gold programs - sanitized for confidentiality, with blind-validation proof.";
const bodyHtml = "\n\n<main>\n<section class=\"page-hero\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <p class=\"eyebrow\">Case studies</p>\n      <h1>Documented, sanitized, real.</h1>\n      <p class=\"lead\">See what CAGE-IN found on real programs - the conventional read, then the targets it surfaced. Each headline case locks to centre as you scroll. Project names, locations and owners are removed for confidentiality; the methods and outcomes are exactly as delivered.</p>\n    </div>\n    <figure class=\"hero-vis cs-hero-vid\">\n      <video data-defer-src=\"/v5/images/deposit3d_rotation_drilling.mp4\" poster=\"/v5/images/deposit3d_rotation_drilling_poster.jpg\"\n             muted loop playsinline preload=\"metadata\"\n             aria-label=\"Rotating 3D deposit model with drill traces\"></video>\n      <figcaption>Every engagement ends in an interactive 3D model your whole board can open.</figcaption>\n    </figure>\n  </div>\n</section>\n\n<!-- ===================== HEADLINER 1 \u00b7 PORPHYRY \u00b7 image LEFT / text RIGHT ===================== -->\n<section class=\"scrub-track\" data-mode=\"wipe\">\n  <div class=\"scrub-sticky\">\n    <div class=\"scrub-inner\">\n      <div class=\"scrub-imgcol\">\n        <div class=\"scrub-frame porph\">\n          <span class=\"scrub-badge\">Same magnetics \u00b7 scroll to reveal</span>\n          <img class=\"scrub-before\" src=\"/v5/images/case1-1.jpg\" alt=\"Magnetic survey before CAGE-IN - one porphyry centre resolved\">\n          <img class=\"scrub-after\"  src=\"/v5/images/case1-2.jpg\" alt=\"Same magnetics after CAGE-IN - known porphyry plus multiple new ranked targets\" style=\"clip-path:inset(0 100% 0 0)\">\n          <span class=\"scrub-corner scrub-corner-l\">Without</span>\n          <span class=\"scrub-corner scrub-corner-r\">With CAGE-IN</span>\n          <div class=\"scrub-divider\" style=\"left:0%\"><span class=\"scrub-knob\" aria-hidden=\"true\">\u27fa</span></div>\n        </div>\n      </div>\n      <div class=\"scrub-text\">\n        <p class=\"cs-caseflag\">Headline case \u00b7 Copper-Gold Porphyry</p>\n        <h2>The same survey, re-read from one centre to a cluster of targets.</h2>\n        <p class=\"scrub-read\">Conventional interpretation of the airborne magnetics resolved <b>one known Porphyry centre</b> - the rest of the survey read as noise.</p>\n        <div class=\"scrub-reveal\">\n          <p class=\"scrub-read-after\">Re-read by CAGE-IN, the same data resolves that centre <b>plus a cluster of new, ranked Porphyry targets</b> around it.</p>\n          <a class=\"scrub-link\" href=\"/v5/eldorado-atlantis-3d.html\" target=\"_blank\" rel=\"noopener\">Fly the 3D model of this system \u2192</a>\n          <div class=\"scrub-payoff\">\n            <div class=\"scrub-metric\"><b>~3 \u2192 12.8+</b><span>Moz Au-eq \u00b7 resource before \u2192 after re-analysis</span></div>\n            <div class=\"scrub-metric\"><b>~US$3.5B</b><span>in-situ Gold value at 2025 prices</span></div>\n          </div>\n        </div>\n        <p class=\"scrub-micro\">Client confidential - no client, project or location disclosed. Resource figures as independently reported.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ===================== HEADLINER 2 \u00b7 NICKEL \u00b7 image RIGHT / text LEFT ===================== -->\n<section class=\"scrub-track img-right\" data-mode=\"wipe\">\n  <div class=\"scrub-sticky\">\n    <div class=\"scrub-inner\">\n      <div class=\"scrub-imgcol\">\n        <div class=\"scrub-frame ni\">\n          <span class=\"scrub-badge\">Same region \u00b7 scroll to reveal</span>\n          <img class=\"scrub-before\" src=\"/v5/images/case4-1.png\" alt=\"Regional nickel datasets alone - no clear targets\">\n          <img class=\"scrub-after\"  src=\"/v5/images/case4-2.png\" alt=\"CAGE-IN integration - discrete nickel targets identified and ranked\" style=\"clip-path:inset(0 100% 0 0)\">\n          <span class=\"scrub-corner scrub-corner-l\">Without</span>\n          <span class=\"scrub-corner scrub-corner-r\">With CAGE-IN</span>\n          <div class=\"scrub-divider\" style=\"left:0%\"><span class=\"scrub-knob\" aria-hidden=\"true\">\u27fa</span></div>\n        </div>\n      </div>\n      <div class=\"scrub-text\">\n        <p class=\"cs-caseflag\">Headline case \u00b7 Greenfield Nickel</p>\n        <h2>Regional data alone found nothing. Integrated, it found a discovery.</h2>\n        <p class=\"scrub-read\">Regional datasets, read on their own, gave <b>no clear targets</b> across greenfield ground with no prior drilling.</p>\n        <div class=\"scrub-reveal\">\n          <p class=\"scrub-read-after\">Fused by CAGE-IN, the same data <b>identified, ranked and drill-confirmed</b> discrete Nickel targets - carried from raw archives to the rig.</p>\n          <div class=\"scrub-payoff\">\n            <div class=\"scrub-metric\"><b>Multi-Mt</b><span>Nickel discovery \u00b7 greenfield, no prior drilling</span></div>\n            <div class=\"scrub-metric\"><b>Drill-confirmed</b><span>targets, raw archives to the rig</span></div>\n          </div>\n        </div>\n        <p class=\"scrub-micro\">Client confidential - no client, project or location disclosed.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ===================== FLAGSHIP STATS ===================== -->\n<section class=\"section\">\n  <div class=\"wrap\">\n    <div class=\"section-head\"><p class=\"eyebrow\">The flagship Nickel program, by the numbers</p></div>\n    <div class=\"case-stats\">\n      <div class=\"case-stat\"><div class=\"num\">308</div><div class=\"lbl\">ranked target polygons</div></div>\n      <div class=\"case-stat\"><div class=\"num\">13</div><div class=\"lbl\">evidence layers scored together</div></div>\n      <div class=\"case-stat\"><div class=\"num\">167</div><div class=\"lbl\">geochemical analytes integrated</div></div>\n      <div class=\"case-stat\"><div class=\"num\">100%</div><div class=\"lbl\">of evidence gaps disclosed, none hidden</div></div>\n    </div>\n  </div>\n</section>\n\n<!-- ===================== SUPPORTING ROW \u00b7 SKARN + EPITHERMAL ===================== -->\n<section class=\"section section-alt\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">More of the record</p>\n      <h2>Same engine, more deposit styles.</h2>\n      <p class=\"lead\">Two further programs where CAGE-IN turned a weak or ambiguous signature into a defined, drillable target. Drag each slider to compare.</p>\n    </div>\n\n    <div class=\"sup-case\">\n      <div class=\"sup-slider\">\n        <div class=\"cmp-slider-frame skarn\">\n          <img class=\"cmp-after-img\"  src=\"/v5/images/case2-2.png\" alt=\"Skarn mineralization defined by CAGE-IN, with new signatures NW of the mine\">\n          <img class=\"cmp-before-img\" src=\"/v5/images/case2-1.png\" alt=\"Skarn before CAGE-IN - very weak geophysical signature\" style=\"clip-path:inset(0 50% 0 0)\">\n          <span class=\"cmp-corner cmp-corner-l\">Without</span>\n          <span class=\"cmp-corner cmp-corner-r\">With CAGE-IN</span>\n          <div class=\"cmp-divider\" style=\"left:50%\"><span class=\"cmp-knob\" aria-hidden=\"true\">\u27fa</span></div>\n          <input class=\"cmp-range\" type=\"range\" min=\"0\" max=\"100\" value=\"50\" aria-label=\"Drag to compare the skarn signature without and with CAGE-IN\">\n        </div>\n      </div>\n      <div class=\"sup-copy\">\n        <p class=\"cs-caseflag\">Skarn \u00b7 Gold-Silver</p>\n        <h3>A signature too weak to use, made drillable.</h3>\n        <p class=\"ba\"><span class=\"lbl\">Without CAGE-IN</span>Operating Gold-Silver mine in a Skarn adjacent to a granitic intrusive. Geophysical signatures of mineralization were very weak and could not be used to identify or expand mineralization trends.</p>\n        <p class=\"ba after\"><span class=\"lbl\">With CAGE-IN</span>CAGE-IN defined the mineralization signature by combining multiple layers of data. Signatures became visible in geophysics, and new similar signatures were identified NW of the existing mine - immediate drill targets for brownfield resource expansion.</p>\n      </div>\n    </div>\n\n    <div class=\"sup-case flip\">\n      <div class=\"sup-slider\">\n        <div class=\"cmp-slider-frame epi\">\n          <img class=\"cmp-after-img\"  src=\"/v5/images/case3-2.png\" alt=\"Epithermal target defined by CAGE-IN, with new signatures along strike\">\n          <img class=\"cmp-before-img\" src=\"/v5/images/case3-1.png\" alt=\"Epithermal before CAGE-IN - indistinguishable signature\" style=\"clip-path:inset(0 50% 0 0)\">\n          <span class=\"cmp-corner cmp-corner-l\">Without</span>\n          <span class=\"cmp-corner cmp-corner-r\">With CAGE-IN</span>\n          <div class=\"cmp-divider\" style=\"left:50%\"><span class=\"cmp-knob\" aria-hidden=\"true\">\u27fa</span></div>\n          <input class=\"cmp-range\" type=\"range\" min=\"0\" max=\"100\" value=\"50\" aria-label=\"Drag to compare the epithermal signature without and with CAGE-IN\">\n        </div>\n      </div>\n      <div class=\"sup-copy\">\n        <p class=\"cs-caseflag\">Epithermal Gold</p>\n        <h3>No contrast between ore and waste - until there was.</h3>\n        <p class=\"ba\"><span class=\"lbl\">Without CAGE-IN</span>Operating Epithermal Gold mine had indistinguishable geophysical signatures - no contrast between ore and waste. The weak contrast could not be used to identify or expand mineralization trends.</p>\n        <p class=\"ba after\"><span class=\"lbl\">With CAGE-IN</span>CAGE-IN defined the mineralization signature by combining multiple layers of data. Signatures became visible in geophysics, and new similar signatures were identified along strike of the existing mine - immediate drill targets for brownfield resource expansion.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ===================== BLIND VALIDATION ===================== -->\n<section class=\"section\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">Blind validation</p>\n      <h2>We prove it on the known before we trust it on the unknown.</h2>\n      <p class=\"lead\">Run blind over mature districts, with no training on the answer, CAGE-IN re-found what decades of drilling had already confirmed. If it can recover the known, you can trust it where nothing is proven yet.</p>\n    </div>\n    <div class=\"case-mini-grid\">\n      <article class=\"case-mini\">\n        <span class=\"case-flag\">Blind validation</span>\n        <h3>Carlin-type Gold district</h3>\n        <p>Run blind over a mature Gold district, the multi-evidence scoring independently recovered the known district footprint - no leakage, no tuning to the answer.</p>\n      </article>\n      <article class=\"case-mini\">\n        <span class=\"case-flag\">Regional scale</span>\n        <h3>Precambrian Craton, Polymetallic</h3>\n        <p>Multi-evidence prospectivity across a Craton-scale search space - the platform at regional reconnaissance scale, turning a national dataset into a ranked map in days.</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<!-- ===================== 3D VIEWER CTA ===================== -->\n<section class=\"section section-alt\">\n  <div class=\"wrap\">\n    <div class=\"fly-cta\">\n      <a class=\"btn btn-line\" href=\"/v5/viewer.html\">Fly the 3D deposit demo <span class=\"arr\">\u2192</span></a>\n      <p class=\"micro\">Instant interactive 3D viewer \u00b7 no login \u00b7 runs in your browser, even offline</p>\n    </div>\n    <p class=\"disclaimer\">Case results are presented in sanitized form for methodology illustration, with project-owner consent where applicable. Nothing on this page constitutes disclosure of exploration results under NI 43-101 or the JORC Code, and no economic potential is implied.</p>\n  </div>\n</section>\n\n<section class=\"cta-band\">\n  <div class=\"wrap\">\n    <h2>The next documented result could be your ground.</h2>\n    <p>Every engagement starts with a 48-hour Prospect Brief - your data, the full council, a fixed price.</p>\n    <a class=\"btn btn-gold\" href=\"/engage\">Get the 48-Hour Prospect Brief <span class=\"arr\">\u2192</span></a>\n  </div>\n</section>\n</main>\n\n<div class=\"spine-band\"><div class=\"wrap\"><p class=\"spine\">Proven on real ground - <span class=\"hl\">conventional read in, CAGE-IN outcome out.</span></p></div></div>\n\n";
---
<V5Layout title={title} description={description}>
<style is:global>

/* ===== case studies · pinned scroll reveal + manual sliders (.scrub-* / .cmp-* / .sup-*) ===== */
.cs-hero-vid video { width:100%; display:block; aspect-ratio:4/3; border-radius:var(--radius); border:1px solid var(--line); background:var(--ink); box-shadow:var(--shadow-1); }
.cs-hero-vid figcaption { font-size:.8rem; color:var(--text-soft); font-style:italic; margin-top:.55rem; }

.scrub-track { position:relative; height:230vh; }
.scrub-sticky { position:sticky; top:0; min-height:100vh; display:flex; align-items:center; }
.scrub-inner { width:min(1200px,92vw); margin:0 auto; display:grid; grid-template-columns:1fr 1fr;
  gap:clamp(2rem,5vw,4.5rem); align-items:center; }

.scrub-frame { position:relative; height:80vh; width:auto; max-width:100%; margin:0 auto;
  border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; background:var(--ink); box-shadow:var(--shadow-2); }
.scrub-frame.porph { aspect-ratio:787/966; }
.scrub-frame.ni    { aspect-ratio:671/1126; }
.scrub-frame img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
.scrub-after { will-change:clip-path; }
.scrub-badge { position:absolute; top:10px; left:10px; z-index:4; font-size:.66rem; font-weight:600; color:#fff;
  background:rgba(16,32,43,.72); border:1px solid rgba(255,255,255,.18); padding:.28em .66em; border-radius:999px; backdrop-filter:blur(3px); }
.scrub-corner { position:absolute; bottom:10px; z-index:4; font-size:.66rem; font-weight:700; letter-spacing:.06em;
  text-transform:uppercase; color:#fff; background:rgba(16,32,43,.72); padding:.26em .66em; border-radius:999px; }
.scrub-corner-l { left:10px; } .scrub-corner-r { right:10px; }
.scrub-divider { position:absolute; top:0; bottom:0; left:0; width:2px; background:var(--gold); transform:translateX(-1px); z-index:5; pointer-events:none; }
.scrub-knob { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:34px; height:34px; border-radius:50%;
  background:var(--gold); color:#10202b; display:flex; align-items:center; justify-content:center; font-size:.95rem; box-shadow:var(--shadow-2); }

.scrub-text { max-width:46ch; }
.scrub-text .cs-caseflag { font-size:.74rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--copper); }
.scrub-text h2 { font-size:clamp(1.9rem,3vw,2.8rem); margin-top:.4rem; }
.scrub-read { font-size:1.08rem; color:var(--text); line-height:1.65; margin-top:1.1rem; }
.scrub-read b { color:var(--copper-deep); }
.scrub-reveal { margin-top:1rem; opacity:0; transform:translateY(14px); }
.scrub-read-after { font-size:1.08rem; color:var(--text); line-height:1.65; }
.scrub-read-after b { color:var(--copper-deep); }
.scrub-link { display:inline-block; margin-top:.7rem; font-size:1.05rem; font-weight:700; color:var(--royal); border-bottom:2px solid currentColor; }
.scrub-payoff { display:flex; flex-wrap:wrap; gap:1.2rem 2.4rem; margin-top:1.4rem; }
.scrub-metric b { display:block; font-family:var(--font-display); font-size:2.1rem; font-weight:600; color:var(--gold-deep); line-height:1.05; }
html[data-theme="dark"] .scrub-metric b { color:var(--gold-soft); }
.scrub-metric span { font-size:.78rem; color:var(--text-soft); }
.scrub-micro { margin-top:.9rem; font-size:.74rem; font-style:italic; color:var(--text-soft); }

.scrub-track.img-right .scrub-text  { order:1; }
.scrub-track.img-right .scrub-imgcol { order:2; }

/* supporting row · manual before/after sliders */
.sup-case { display:grid; grid-template-columns:1.25fr 1fr; gap:clamp(1.6rem,4vw,3rem); align-items:center; margin-top:2.6rem; }
.sup-case.flip .sup-slider { order:2; } .sup-case.flip .sup-copy { order:1; }
.sup-copy .cs-caseflag { font-size:.72rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--copper); }
.sup-copy h3 { font-size:1.35rem; margin-top:.3rem; }
.sup-copy .ba { margin-top:.85rem; font-size:.92rem; line-height:1.55; color:var(--text); }
.sup-copy .ba .lbl { display:block; font-size:.66rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--copper-deep); margin-bottom:.15rem; }
.cmp-slider-frame { position:relative; width:100%; border-radius:var(--radius); overflow:hidden; border:1px solid var(--line); background:var(--ink); box-shadow:var(--shadow-1); }
.cmp-slider-frame.skarn { aspect-ratio:1370/484; }
.cmp-slider-frame.epi   { aspect-ratio:989/643; }
.cmp-slider-frame img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
.cmp-corner { position:absolute; bottom:10px; z-index:4; font-size:.64rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:#fff; background:rgba(16,32,43,.72); padding:.24em .6em; border-radius:999px; }
.cmp-corner-l { left:10px; } .cmp-corner-r { right:10px; }
.cmp-divider { position:absolute; top:0; bottom:0; left:50%; width:2px; background:var(--gold); transform:translateX(-1px); z-index:4; pointer-events:none; }
.cmp-knob { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:32px; height:32px; border-radius:50%; background:var(--gold); color:#10202b; display:flex; align-items:center; justify-content:center; font-size:.9rem; box-shadow:var(--shadow-2); }
.cmp-range { position:absolute; inset:0; width:100%; height:100%; margin:0; opacity:0; cursor:ew-resize; z-index:5; }

@media (max-width:900px){
  .scrub-inner { grid-template-columns:1fr; gap:1.4rem; }
  .scrub-track.img-right .scrub-text { order:2; } .scrub-track.img-right .scrub-imgcol { order:1; }
  .scrub-frame { height:46vh; }
  .scrub-text h2 { font-size:1.5rem; }
  .sup-case { grid-template-columns:1fr; }
  .sup-case.flip .sup-slider { order:1; } .sup-case.flip .sup-copy { order:2; }
}
@media (prefers-reduced-motion: reduce){
  .scrub-track { height:auto; }
  .scrub-sticky { position:static; min-height:0; padding:2.5rem 0; }
  .scrub-reveal { opacity:1 !important; transform:none !important; }
}

</style>
<Fragment set:html={bodyHtml} />
<script is:inline>

(function(){
  var tracks=[].slice.call(document.querySelectorAll('.scrub-track'));
  if(!tracks.length) return;
  function apply(t,p){
    var after=t.querySelector('.scrub-after'), div=t.querySelector('.scrub-divider');
    var cl=t.querySelector('.scrub-corner-l'), cr=t.querySelector('.scrub-corner-r');
    var rv=t.querySelector('.scrub-reveal');
    after.style.clipPath='inset(0 '+((1-p)*100).toFixed(2)+'% 0 0)';
    if(div) div.style.left=(p*100).toFixed(2)+'%';
    if(cl) cl.style.opacity=(1-p*0.8).toFixed(2);
    if(cr) cr.style.opacity=(0.2+p*0.8).toFixed(2);
    if(rv){ var r=Math.max(0,Math.min(1,(p-0.2)/0.55)); rv.style.opacity=r.toFixed(2); rv.style.transform='translateY('+((1-r)*14).toFixed(1)+'px)'; }
  }
  var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce){ tracks.forEach(function(t){ apply(t,1); }); return; }
  function update(){
    var vh=window.innerHeight||document.documentElement.clientHeight;
    tracks.forEach(function(t){
      var r=t.getBoundingClientRect();
      var span=t.offsetHeight - vh;
      var prog = span>0 ? (-r.top)/span : 0;
      var p = Math.max(0, Math.min(1, prog/0.85));
      apply(t, p);
    });
  }
  var ticking=false;
  function onScroll(){ if(ticking)return; ticking=true; requestAnimationFrame(function(){ update(); ticking=false; }); }
  window.addEventListener('scroll', onScroll, {passive:true});
  window.addEventListener('resize', onScroll);
  update();
})();

/* supporting row — manual drag sliders */
(function(){
  document.querySelectorAll('.cmp-slider-frame').forEach(function(f){
    var range=f.querySelector('.cmp-range'), before=f.querySelector('.cmp-before-img'), div=f.querySelector('.cmp-divider');
    function upd(){ var v=+range.value; before.style.clipPath='inset(0 '+(100-v)+'% 0 0)'; if(div) div.style.left=v+'%'; }
    range.addEventListener('input', upd); upd();
  });
})();

</script>
</V5Layout>
