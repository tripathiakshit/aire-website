---
import V5Layout from '../layouts/V5Layout.astro';
const title = "Contact - start the conversation | AiRE";
const description = "Contact AiRE: book a discovery call with Dr. Amit Tripathi, or send your project for a tailored response within two working days.";
const bodyHtml = "\n\n<main>\n<section class=\"page-hero\">\n  <div class=\"wrap\">\n    <p class=\"eyebrow\">Contact</p>\n    <h1>Start the conversation.</h1>\n    <p class=\"lead\">Tell us what you need and we&rsquo;ll come back with a tailored response within two working days - or book a discovery call with Dr.&nbsp;Amit Tripathi directly. NDA first, always; data rooms, not email attachments.</p>\n  </div>\n</section>\n\n<section class=\"section\">\n  <div class=\"wrap\">\n    <div class=\"ct-actions\">\n      <article class=\"ct-action feature\" id=\"book-call\">\n        <p class=\"ct-label\">Book a discovery call</p>\n        <h3>A 30-minute call with Dr. Amit Tripathi</h3>\n        <p>Schedule 30 minutes directly with the founder - bring your messiest folder, and we&rsquo;ll tell you honestly whether your data can support an AiRE run.</p>\n        <a class=\"btn btn-gold\" href=\"https://calendar.google.com/calendar/appointments/schedules/AcZssZ20nIPf8pxPqOw63IdBsaFnXHofP4_FtCx0v4bSWFiSztjr4p6gOcFo-xFIINByGhYQs0-bGjAO\" target=\"_blank\" rel=\"noopener\">Open the scheduler <span class=\"arr\">\u2192</span></a>\n      </article>\n      <article class=\"ct-action\">\n        <p class=\"ct-label\">Send your project</p>\n        <h3>Tell us what you need</h3>\n        <p>Share your project and data situation through our secure enquiry form. It goes straight to Dr.&nbsp;Tripathi - no mailing lists, no drip campaigns.</p>\n        <a class=\"btn btn-line\" href=\"https://docs.google.com/forms/d/e/1FAIpQLSeFNPr0-H4ky-NaOKsGm2IuuN0wi9w0SYhTsu8GZ2wKBZ5Rlw/viewform\" target=\"_blank\" rel=\"noopener\">Open the enquiry form <span class=\"arr\">\u2192</span></a>\n      </article>\n    </div>\n\n    <div class=\"ct-details\">\n      <div>\n        <p class=\"ct-label\">Direct</p>\n        <p><span class=\"nm\">Dr. Amit Tripathi</span><br>Principal Consultant &amp; Founder<br>\n          <a class=\"textlink\" href=\"mailto:info@geoexplorationllc.com\">info@geoexplorationllc.com</a><br>\n          <a class=\"textlink\" href=\"https://www.linkedin.com/in/amit-tripathi-b7a5567/\" target=\"_blank\" rel=\"noopener\">LinkedIn &rarr;</a></p>\n      </div>\n      <div>\n        <p class=\"ct-label\">Head office</p>\n        <p>1310 Amethyst, My Home Jewel,<br>Miyapur, Hyderabad 500049, India</p>\n      </div>\n      <div>\n        <p class=\"ct-label\">Branch office</p>\n        <p>24 Rue Loiselle, Les Coteaux,<br>QC J7X 0A9, Canada</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"cta-band\">\n  <div class=\"wrap\">\n    <h2>Or start with the Prospect Brief.</h2>\n    <p>Your data, the full council, a fixed price - a documented read on your ground in 48 hours.</p>\n    <a class=\"btn btn-gold\" href=\"/engage\">Get the 48-Hour Prospect Brief <span class=\"arr\">\u2192</span></a>\n  </div>\n</section>\n</main>\n\n";
---
<V5Layout title={title} description={description}>
<style is:global>

/* contact page only (.ct-*) */
.ct-actions { display:grid; grid-template-columns:1fr 1fr; gap:1.3rem; }
.ct-action { background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow-1); padding:1.9rem 2rem; display:flex; flex-direction:column; }
.ct-action.feature { border-color:var(--gold); }
.ct-label { font-size:.68rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--copper); }
.ct-action h3 { font-size:1.3rem; margin:.45rem 0 .6rem; }
.ct-action p { font-size:.93rem; color:var(--text-soft); line-height:1.6; flex:1; }
.ct-action .btn { margin-top:1.5rem; align-self:flex-start; }
.ct-details { display:grid; grid-template-columns:repeat(3,1fr); gap:1.8rem; margin-top:1.9rem; padding-top:1.9rem; border-top:1px solid var(--line); }
.ct-details .ct-label { margin-bottom:.5rem; }
.ct-details p { font-size:.9rem; color:var(--text-soft); line-height:1.55; }
.ct-details .nm { color:var(--ink-text); font-weight:600; }
.ct-details a.textlink { font-size:.9rem; }
@media (max-width:760px){ .ct-actions { grid-template-columns:1fr; } .ct-details { grid-template-columns:1fr; gap:1.3rem; } }

</style>
<Fragment set:html={bodyHtml} />
</V5Layout>
