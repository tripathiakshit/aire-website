---
import PageLayout from '../layouts/PageLayout.astro';

// External intake endpoints (Google Calendar appointment scheduler + Google Form)
const SCHEDULER_URL = 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ20nIPf8pxPqOw63IdBsaFnXHofP4_FtCx0v4bSWFiSztjr4p6gOcFo-xFIINByGhYQs0-bGjAO';
const ENQUIRY_FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSeFNPr0-H4ky-NaOKsGm2IuuN0wi9w0SYhTsu8GZ2wKBZ5Rlw/viewform';
---

<PageLayout
  title="Contact — Start the conversation | AiRE"
  description="Contact AiRE: book a 30-minute discovery call directly with Dr. Amit Tripathi, or send your project through our secure enquiry form for a tailored response within two working days."
>
  <!-- HERO -->
  <section class="py-14 md:py-20">
    <div class="mx-auto w-[min(1140px,90vw)]">
      <p class="v5-eyebrow">Contact</p>
      <h1 class="mt-3 font-fraunces text-4xl font-medium leading-[1.1] text-ink sm:text-5xl dark:text-canvas">Start the conversation.</h1>
      <p class="v5-lead mt-5 max-w-3xl">Tell us what you need and we&rsquo;ll come back with a tailored response within two working days — or book a discovery call with Dr.&nbsp;Amit Tripathi directly. NDA first, always; data rooms, not email attachments.</p>
    </div>
  </section>

  <!-- TWO WAYS IN -->
  <section class="border-t border-line bg-canvas-alt py-16 md:py-24 dark:border-ink-2 dark:bg-ink-2/40">
    <div class="mx-auto w-[min(1140px,90vw)]">
      <div class="grid gap-5 md:grid-cols-2">
        <!-- Book a discovery call -->
        <article id="book-call" class="flex flex-col rounded-2xl border border-cage-gold bg-surface p-7 shadow-sm sm:p-9 dark:border-cage-gold/60 dark:bg-ink-2" data-reveal>
          <p class="text-xs font-semibold uppercase tracking-wider text-copper dark:text-copper-soft">Book a discovery call</p>
          <h2 class="mt-2 font-fraunces text-2xl text-ink dark:text-canvas">A 30-minute call with Dr.&nbsp;Amit Tripathi</h2>
          <p class="mt-3 flex-1 text-sm text-text-soft">Schedule 30 minutes directly with the founder — bring your messiest folder, and we&rsquo;ll tell you honestly whether your data can support an AiRE run.</p>
          <a class="v5-btn-gold mt-6 self-start" href={SCHEDULER_URL} target="_blank" rel="noopener">Open the scheduler <span aria-hidden="true">→</span></a>
        </article>

        <!-- Send your project -->
        <article class="flex flex-col rounded-2xl border border-line bg-surface p-7 shadow-sm sm:p-9 dark:border-ink-2 dark:bg-ink-2" data-reveal>
          <p class="text-xs font-semibold uppercase tracking-wider text-copper dark:text-copper-soft">Send your project</p>
          <h2 class="mt-2 font-fraunces text-2xl text-ink dark:text-canvas">Tell us what you need</h2>
          <p class="mt-3 flex-1 text-sm text-text-soft">Share your project and data situation through our secure enquiry form. It goes straight to Dr.&nbsp;Tripathi — no mailing lists, no drip campaigns.</p>
          <a class="v5-btn-line mt-6 self-start" href={ENQUIRY_FORM_URL} target="_blank" rel="noopener">Open the enquiry form <span aria-hidden="true">→</span></a>
        </article>
      </div>

      <!-- Contact details -->
      <div class="mt-8 grid gap-6 border-t border-line pt-8 sm:grid-cols-3 dark:border-ink-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-copper dark:text-copper-soft">Direct</p>
          <p class="mt-2 text-sm text-text-soft">
            <span class="font-semibold text-ink dark:text-canvas">Dr. Amit Tripathi</span><br />
            Principal Consultant &amp; Founder<br />
            <a class="v5-link" href="mailto:info@geoexplorationllc.com">info@geoexplorationllc.com</a><br />
            <a class="v5-link" href="https://www.linkedin.com/in/amit-tripathi-b7a5567/" target="_blank" rel="noopener">LinkedIn &rarr;</a>
          </p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-copper dark:text-copper-soft">Head office</p>
          <p class="mt-2 text-sm text-text-soft">1310 Amethyst, My Home Jewel,<br />Miyapur, Hyderabad 500049, India</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-copper dark:text-copper-soft">Branch office</p>
          <p class="mt-2 text-sm text-text-soft">24 Rue Loiselle, Les Coteaux,<br />QC J7X 0A9, Canada</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROSPECT BRIEF CTA -->
  <section class="bg-ink py-16 text-center text-canvas md:py-20">
    <div class="mx-auto w-[min(860px,90vw)]">
      <h2 class="font-fraunces text-3xl font-medium md:text-4xl">Or start with the Prospect Brief.</h2>
      <p class="mt-3 text-canvas/70">Your data, the full council, a fixed price — a documented read on your ground in 48 hours.</p>
      <a class="v5-btn-gold mt-6" href="/engage">Get the 48-Hour Prospect Brief <span aria-hidden="true">→</span></a>
    </div>
  </section>
</PageLayout>
