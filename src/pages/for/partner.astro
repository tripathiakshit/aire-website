---
import { Image } from 'astro:assets';
import { Layers, Brain, Activity, Satellite, FileCheck, MapPin, Server, Coins, Tag, Network, Lock } from 'lucide-astro';
import PageLayout from '../../layouts/PageLayout.astro';

import cageInImg from '../../assets/cage-in_pic1-min.jpg';
import structuralModellingImg from '../../assets/structural_modelling.png';
import geospatialImg from '../../assets/geospatial.jpg';
import aiGeoImg from '../../assets/ai-geo-identifying-prospects.png';
---

<PageLayout
  title="For Strategic Partners — AI Resource Exploration"
  description="Co-invest in the next-generation exploration stack — capital, product, or distribution arrangements built around AiRE's IP portfolio, multi-method scoring architecture, and product roadmap."
>

  <!-- Hero -->
  <section class="bg-geo-slate text-white py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-reveal>
      <p class="text-geo-gold text-xs font-semibold uppercase tracking-[0.3em] mb-5">For Strategic Partners</p>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl text-white leading-[1.08] mb-6">
        Co-investment in the next-generation exploration stack.
      </h1>
      <p class="text-slate-400 text-base md:text-lg leading-relaxed max-w-prose mx-auto mb-8">
        AiRE owns a unified portfolio of mineral-exploration software — multi-method prospectivity, 3D scoring, regional reconnaissance, literature synthesis, and data ingestion — converging on a forthcoming flagship platform. For corporate venture arms, mining majors with technical-software portfolios, and strategic investors evaluating positions in indigenous AI for resource exploration, this is where the roadmap conversation starts.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contact"
          class="w-full sm:w-auto px-8 py-3.5 rounded bg-geo-gold text-white font-semibold text-sm uppercase tracking-wider hover:bg-amber-500 transition-colors text-center"
        >
          Open a partner conversation →
        </a>
        <a
          href="/contact"
          class="w-full sm:w-auto px-8 py-3.5 rounded border border-white/20 text-white/80 font-medium text-sm hover:bg-white/10 transition-colors"
        >
          Request the partnership brief
        </a>
      </div>
    </div>
  </section>

  <!-- The IP portfolio -->
  <section class="py-12 md:py-20 bg-geo-deep">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10" data-reveal>
        <p class="text-geo-gold text-xs font-semibold uppercase tracking-[0.25em] mb-3">What's Being Built</p>
        <h2 class="font-display text-3xl md:text-5xl text-white mb-4 leading-tight">A unified product suite — converging on Garuda.</h2>
        <p class="text-slate-400 text-base md:text-lg leading-relaxed max-w-prose mx-auto">
          Five products on disk today. Multiple capabilities being unified into the forthcoming Garuda CAGE-IN Mineral Prospectivity Mapper — a single flagship platform with the underlying methods preserved as modules.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal>
        <a href="/technologies/cage-in" class="group card-dark rounded-2xl overflow-hidden hover:shadow-xl hover:shadow-black/30 transition-all duration-300 flex flex-col">
          <div class="h-40 overflow-hidden">
            <Image src={cageInImg} alt="CAGE-IN Mineral Prospectivity" width={600} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-5 flex flex-col flex-1 border-t-2 border-transparent group-hover:border-geo-gold transition-colors duration-300">
            <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">Flagship · Public Stable v1.0.0 Garuda</p>
            <h3 class="font-display text-lg text-white font-semibold mb-2 leading-snug">CAGE-IN Mineral Prospectivity</h3>
            <p class="text-slate-400 text-sm leading-relaxed flex-1">Multi-method prospectivity — Method A WLC + Method B RF + Ensemble Fusion. Six sensors, 12 deposit models, 220+ regression tests.</p>
          </div>
        </a>
        <a href="/technologies/bhumi3dmapper" class="group card-dark rounded-2xl overflow-hidden hover:shadow-xl hover:shadow-black/30 transition-all duration-300 flex flex-col">
          <div class="h-40 overflow-hidden">
            <Image src={structuralModellingImg} alt="Bhumi3DMapper" width={600} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-5 flex flex-col flex-1 border-t-2 border-transparent group-hover:border-geo-gold transition-colors duration-300">
            <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">Production · 3D Prospectivity</p>
            <h3 class="font-display text-lg text-white font-semibold mb-2 leading-snug">Bhumi3DMapper</h3>
            <p class="text-slate-400 text-sm leading-relaxed flex-1">3D mineral prospectivity for working geologists. Proximity + Blind models in one pipeline; pure-Python core; deposit-agnostic adapter.</p>
          </div>
        </a>
        <a href="/technologies/batch-gis-loader" class="group card-dark rounded-2xl overflow-hidden hover:shadow-xl hover:shadow-black/30 transition-all duration-300 flex flex-col">
          <div class="h-40 overflow-hidden">
            <Image src={geospatialImg} alt="Batch GIS File Loader" width={600} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-5 flex flex-col flex-1 border-t-2 border-transparent group-hover:border-geo-gold transition-colors duration-300">
            <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">Production · Data Ingestion</p>
            <h3 class="font-display text-lg text-white font-semibold mb-2 leading-snug">Batch GIS File Loader</h3>
            <p class="text-slate-400 text-sm leading-relaxed flex-1">Recursive folder-tree scan over 20+ vector and raster formats. Production-deployed at AiRE on every new client engagement.</p>
          </div>
        </a>
        <a href="/technologies/omniminer" class="group card-dark rounded-2xl overflow-hidden hover:shadow-xl hover:shadow-black/30 transition-all duration-300 flex flex-col">
          <div class="h-40 overflow-hidden">
            <Image src={aiGeoImg} alt="OmniMiner" width={600} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-5 flex flex-col flex-1 border-t-2 border-transparent group-hover:border-geo-gold transition-colors duration-300">
            <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">In Development · Regional Reconnaissance</p>
            <h3 class="font-display text-lg text-white font-semibold mb-2 leading-snug">OmniMiner</h3>
            <p class="text-slate-400 text-sm leading-relaxed flex-1">Spectral analysis for greenfield reconnaissance over thousands of square kilometres — Landsat, Sentinel and ASTER pipelines built into QGIS.</p>
          </div>
        </a>
        <a href="/technologies/varahmihir" class="group card-dark rounded-2xl overflow-hidden hover:shadow-xl hover:shadow-black/30 transition-all duration-300 flex flex-col">
          <div class="h-40 overflow-hidden">
            <Image src={aiGeoImg} alt="Varahmihir AI" width={600} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-5 flex flex-col flex-1 border-t-2 border-transparent group-hover:border-geo-gold transition-colors duration-300">
            <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">In Development · AI Researcher</p>
            <h3 class="font-display text-lg text-white font-semibold mb-2 leading-snug">Varahmihir AI</h3>
            <p class="text-slate-400 text-sm leading-relaxed flex-1">Area- and commodity-scoped automated research over the open web. Surfaces public-domain reports, academic literature, and mineral-occurrence data with full citations.</p>
          </div>
        </a>
        <div class="card-dark rounded-2xl flex flex-col items-center justify-center text-center p-6 border-dashed border-2 border-geo-gold/30">
          <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">Forthcoming</p>
          <h3 class="font-display text-lg text-white font-semibold mb-2 leading-snug">Garuda CAGE-IN Mineral Prospectivity Mapper</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Unification of geophysical, alteration, geochemical, and ensemble methods under one platform. Built on the production CAGE-IN core. Roadmap shared under NDA.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why the stack compounds -->
  <section class="py-12 md:py-20 bg-geo-slate">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10" data-reveal>
        <p class="text-geo-gold text-xs font-semibold uppercase tracking-[0.25em] mb-3">Why the Stack Compounds</p>
        <h2 class="font-display text-3xl md:text-5xl text-white mb-4 leading-tight">Production engineering. Peer-reviewed methodology. India-held IP.</h2>
        <p class="text-slate-400 text-base md:text-lg leading-relaxed max-w-prose mx-auto">
          Six structural reasons the portfolio is not replicable on commodity timelines or commodity budgets.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" data-reveal>
        <div class="card-dark rounded-xl p-5">
          <div class="w-10 h-10 rounded-lg bg-geo-gold/15 text-geo-gold flex items-center justify-center mb-3">
            <FileCheck size={20} />
          </div>
          <h3 class="font-display text-base text-white font-semibold mb-2 leading-snug">220+ regression tests</h3>
          <p class="text-slate-400 text-xs leading-relaxed">Phase-specific test classes cover spectral, geophysics, terrain, geology, geochemistry. Code-vs-doc drift prevented at merge gate.</p>
        </div>
        <div class="card-dark rounded-xl p-5">
          <div class="w-10 h-10 rounded-lg bg-geo-gold/15 text-geo-gold flex items-center justify-center mb-3">
            <Brain size={20} />
          </div>
          <h3 class="font-display text-base text-white font-semibold mb-2 leading-snug">Multi-method scoring</h3>
          <p class="text-slate-400 text-xs leading-relaxed">Method A knowledge-driven WLC + Method B Random Forest with spatial-block CV + Ensemble Fusion via Dempster-Shafer. Three engines, one ranked output.</p>
        </div>
        <div class="card-dark rounded-xl p-5">
          <div class="w-10 h-10 rounded-lg bg-geo-gold/15 text-geo-gold flex items-center justify-center mb-3">
            <Satellite size={20} />
          </div>
          <h3 class="font-display text-base text-white font-semibold mb-2 leading-snug">Six sensor families</h3>
          <p class="text-slate-400 text-xs leading-relaxed">ASTER · Landsat 8/9 · Sentinel-2 · EMIT L2A/L2B · PALSAR SAR · EnMAP. 21 spectral alteration indices feed 28 composite pre-computations across six evidence families.</p>
        </div>
        <div class="card-dark rounded-xl p-5">
          <div class="w-10 h-10 rounded-lg bg-geo-gold/15 text-geo-gold flex items-center justify-center mb-3">
            <Layers size={20} />
          </div>
          <h3 class="font-display text-base text-white font-semibold mb-2 leading-snug">12 deposit models</h3>
          <p class="text-slate-400 text-xs leading-relaxed">Calibrated against the published prospectivity literature. Cross-validated on Nevada, Titiribi, Rajasthan, and Uganda terrains.</p>
        </div>
        <div class="card-dark rounded-xl p-5">
          <div class="w-10 h-10 rounded-lg bg-geo-gold/15 text-geo-gold flex items-center justify-center mb-3">
            <Activity size={20} />
          </div>
          <h3 class="font-display text-base text-white font-semibold mb-2 leading-snug">Production-grade compute</h3>
          <p class="text-slate-400 text-xs leading-relaxed">GPU-tiled spectral index computation (CuPy with hardware-adaptive VRAM scheduling). Numba-accelerated scoring (13.6× over pure Python). 2–5 minutes per 1,000 km².</p>
        </div>
        <div class="card-dark rounded-xl p-5">
          <div class="w-10 h-10 rounded-lg bg-geo-gold/15 text-geo-gold flex items-center justify-center mb-3">
            <MapPin size={20} />
          </div>
          <h3 class="font-display text-base text-white font-semibold mb-2 leading-snug">India-held IP, India-incorporated</h3>
          <p class="text-slate-400 text-xs leading-relaxed">AiRE is an Indian private limited company (CIN U74999TG2017PTC115998). All IP wholly owned and India-resident. India-resident processing on request.</p>
        </div>
      </div>

      <div class="text-center mt-10" data-reveal>
        <a href="/technologies/cage-in" class="inline-flex items-center gap-2 text-geo-gold text-sm font-semibold uppercase tracking-wider hover:text-amber-400 transition-colors">
          Read the full CAGE-IN technical brief →
        </a>
      </div>
    </div>
  </section>

  <!-- Engagement shapes -->
  <section class="py-12 md:py-20 bg-geo-deep">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10" data-reveal>
        <p class="text-geo-gold text-xs font-semibold uppercase tracking-[0.25em] mb-3">Engagement Shapes</p>
        <h2 class="font-display text-3xl md:text-5xl text-white mb-4 leading-tight">Capital, product, or distribution. Or all three.</h2>
        <p class="text-slate-400 text-base md:text-lg leading-relaxed max-w-prose mx-auto">
          Partnership shapes that have surfaced in conversations to date. Each is a starting point, not a fixed template — terms calibrate to what your portfolio actually needs.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-reveal>
        <div class="card-dark rounded-xl p-6 flex flex-col">
          <div class="w-12 h-12 rounded-lg bg-geo-primary/20 text-geo-secondary flex items-center justify-center mb-4">
            <Coins size={22} />
          </div>
          <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">Capital Partner</p>
          <h3 class="font-display text-xl text-white font-semibold mb-3 leading-snug">Strategic investment in the productisation roadmap</h3>
          <p class="text-slate-300 text-sm leading-relaxed flex-1">
            Equity or convertible-debt position aligned to Garuda platformisation milestones. Returns from licensing revenue plus the unified-stack valuation arc. Best for: corporate venture arms with exploration-tech mandates; sovereign-wealth desks tracking indigenous AI.
          </p>
        </div>
        <div class="card-dark rounded-xl p-6 flex flex-col">
          <div class="w-12 h-12 rounded-lg bg-geo-primary/20 text-geo-secondary flex items-center justify-center mb-4">
            <Tag size={22} />
          </div>
          <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">Product Partner</p>
          <h3 class="font-display text-xl text-white font-semibold mb-3 leading-snug">White-label / embedded-licence + pull-through use</h3>
          <p class="text-slate-300 text-sm leading-relaxed flex-1">
            Operate CAGE-IN (and the Garuda stack as it ships) on your own exploration portfolio under embedded-licence terms — and offer the same capability to your clients under your brand. Returns: discovery velocity on your own ground plus a defensible technical differentiator versus competing operators.
          </p>
        </div>
        <div class="card-dark rounded-xl p-6 flex flex-col">
          <div class="w-12 h-12 rounded-lg bg-geo-primary/20 text-geo-secondary flex items-center justify-center mb-4">
            <Network size={22} />
          </div>
          <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">Distribution Partner</p>
          <h3 class="font-display text-xl text-white font-semibold mb-3 leading-snug">Regional or sector channel</h3>
          <p class="text-slate-300 text-sm leading-relaxed flex-1">
            Co-marketing and referral arrangements into a specific jurisdiction or sector you already serve — Canadian junior community, ASX mid-tier, African government surveys, Middle East critical-minerals programmes. Revenue share on engagements you originate; technical delivery stays with AiRE.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Living Methodology callout -->
  <section class="py-12 md:py-16 bg-geo-slate">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
      <div class="bg-geo-gold/8 border border-geo-gold/30 border-l-8 border-l-geo-gold rounded p-8">
        <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-3">Living Methodology</p>
        <p class="font-display italic text-white text-xl md:text-2xl leading-snug mb-4">
          AI-backed fluid software is a defensive moat. Frozen models and point-in-time AI products cannot replicate continuous-curation engineering on commodity timelines.
        </p>
        <a href="/technologies/cage-in#living-methodology" class="text-geo-gold text-xs font-semibold uppercase tracking-wider hover:text-amber-400 transition-colors">
          How the moat compounds →
        </a>
      </div>
    </div>
  </section>

  <!-- Roadmap (high-level, no fixed dates) -->
  <section class="py-12 md:py-20 bg-geo-deep">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10" data-reveal>
        <p class="text-geo-gold text-xs font-semibold uppercase tracking-[0.25em] mb-3">Where We're Going</p>
        <h2 class="font-display text-3xl md:text-5xl text-white mb-4 leading-tight">From plugin to platform. From platform to ecosystem.</h2>
        <p class="text-slate-400 text-base md:text-lg leading-relaxed max-w-prose mx-auto">
          Phases sequenced so each one funds the next. Specific timelines are shared in the partnership brief under NDA.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-reveal>
        <div class="card-dark rounded-xl p-6 flex flex-col">
          <p class="text-emerald-300 text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">Now</p>
          <h3 class="font-display text-xl text-white font-semibold mb-3 leading-snug">Production stack, first institutional conversations</h3>
          <ul class="text-slate-300 space-y-2 text-sm flex-1">
            <li class="flex items-start gap-2"><span class="text-geo-gold mt-0.5 shrink-0">→</span>CAGE-IN v1.0 Garuda public stable</li>
            <li class="flex items-start gap-2"><span class="text-geo-gold mt-0.5 shrink-0">→</span>Five products on disk; three services in active delivery</li>
            <li class="flex items-start gap-2"><span class="text-geo-gold mt-0.5 shrink-0">→</span>First government-scale procurement conversations open</li>
          </ul>
        </div>
        <div class="card-dark rounded-xl p-6 flex flex-col">
          <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">Next</p>
          <h3 class="font-display text-xl text-white font-semibold mb-3 leading-snug">Garuda consolidation, web platformisation, first reference deployment</h3>
          <ul class="text-slate-300 space-y-2 text-sm flex-1">
            <li class="flex items-start gap-2"><span class="text-geo-gold mt-0.5 shrink-0">→</span>Garuda CAGE-IN Mineral Prospectivity Mapper as unified product</li>
            <li class="flex items-start gap-2"><span class="text-geo-gold mt-0.5 shrink-0">→</span>Multi-tenant web platform on MeitY-empanelled infrastructure</li>
            <li class="flex items-start gap-2"><span class="text-geo-gold mt-0.5 shrink-0">→</span>First sanctioned institutional reference engagement</li>
          </ul>
        </div>
        <div class="card-dark rounded-xl p-6 flex flex-col">
          <p class="text-geo-secondary text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">Later</p>
          <h3 class="font-display text-xl text-white font-semibold mb-3 leading-snug">Ecosystem and international footprint</h3>
          <ul class="text-slate-300 space-y-2 text-sm flex-1">
            <li class="flex items-start gap-2"><span class="text-geo-gold mt-0.5 shrink-0">→</span>Productised services pipeline (GPI, Drill DB, Spectral)</li>
            <li class="flex items-start gap-2"><span class="text-geo-gold mt-0.5 shrink-0">→</span>International IP filings into resource-rich jurisdictions</li>
            <li class="flex items-start gap-2"><span class="text-geo-gold mt-0.5 shrink-0">→</span>Distribution partnerships across exploration-active geographies</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- How a conversation starts -->
  <section class="py-12 md:py-20 bg-geo-slate">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-reveal>
      <div class="inline-flex w-14 h-14 rounded-full bg-geo-gold/15 text-geo-gold items-center justify-center mb-5">
        <Lock size={24} />
      </div>
      <p class="text-geo-gold text-xs font-semibold uppercase tracking-[0.25em] mb-3">How a Conversation Starts</p>
      <h2 class="font-display text-3xl md:text-5xl text-white mb-6 leading-tight">Mutual NDA. Sealed technical memorandum. Then a deeper read.</h2>
      <p class="text-slate-300 text-base md:text-lg leading-relaxed max-w-prose mx-auto mb-4">
        What you have read on this site is the publicly-shareable layer of the technology — enough to evaluate the architecture and the proposition. Behind mutual NDA, we share the platform-architecture detail, deployment specifics, and the IP-portfolio dossier including filings in progress.
      </p>
      <p class="text-slate-400 text-base leading-relaxed max-w-prose mx-auto">
        Trade-secret elements — the reasoning flowsheet, the weight tables, the implementation-level deposit-model rules — remain sealed and are exposed only as required inside a closed engagement, never as part of a partnership conversation.
      </p>
    </div>
  </section>

  <!-- CTA banner -->
  <section class="py-14 md:py-24 bg-geo-slate text-white relative overflow-hidden border-t border-white/5">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: repeating-linear-gradient(45deg, #fff 0, #fff 1px, transparent 0, transparent 50%); background-size: 30px 30px;"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-reveal>
      <p class="text-geo-gold text-xs font-semibold uppercase tracking-[0.3em] mb-4">Open a Conversation</p>
      <h2 class="font-display text-3xl md:text-5xl text-white mb-6 leading-tight">Tell us about your portfolio. We will share the brief.</h2>
      <p class="text-slate-300 text-base md:text-lg leading-relaxed max-w-md mx-auto mb-8">
        A first call with Dr. Amit Tripathi, founder. 30 minutes. We will walk your strategic posture in exploration tech, where AiRE's stack fits the gap, and what a partnership shape could look like. Mutual NDA from the first message.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-5">
        <a
          href="/contact"
          class="w-full sm:w-auto px-8 py-3.5 rounded bg-geo-gold text-white font-semibold text-sm uppercase tracking-wider hover:bg-amber-500 transition-colors"
        >
          Open a partner conversation →
        </a>
        <a
          href="/contact"
          class="w-full sm:w-auto px-8 py-3.5 rounded border border-white/20 text-white/80 font-medium text-sm hover:bg-white/10 transition-colors"
        >
          Request the partnership brief
        </a>
      </div>
      <p class="text-slate-500 text-[10px] uppercase tracking-widest">Mutual NDA · Sealed technical memorandum on request · Confidentiality maintained throughout</p>
    </div>
  </section>

</PageLayout>
