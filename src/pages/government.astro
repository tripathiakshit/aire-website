---
import V5Layout from '../layouts/V5Layout.astro';
const title = "For Governments & National Surveys - Sovereign exploration intelligence | AiRE";
const description = "Technology-led national exploration programs: regional prospectivity mapping, skills transfer to your geologists, and full data sovereignty. Defensible budgets, auditable methods.";
const bodyHtml = "\n\n<main>\n<section class=\"page-hero\">\n  <div class=\"wrap\">\n    <p class=\"eyebrow\">/government \u00b7 for governments, sovereign wealth &amp; development banks</p>\n    <h1>National-scale targeting. Sovereign data. Local capability that outlasts the contract.</h1>\n    <p class=\"lead\">AiRE builds technology-led exploration programs for geological surveys, ministries, sovereign wealth funds and development banks - regional and national prospectivity mapping over your existing datasets that de-risks exploration and draws investment into your critical and strategic minerals, with the methods documented, the budgets defensible, and your own geologists trained to run the system when we leave.</p>\n  </div>\n</section>\n\n<section class=\"section\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">Why programs choose AiRE</p>\n      <h2>Auditable methods are fundable methods.</h2>\n      <p class=\"lead\">A ministry must defend its exploration budget to a parliament, not a shareholder. Every AiRE output traces each score to named evidence layers and published literature - so your program review answers itself.</p>\n    </div>\n    <div class=\"feature-cols\">\n      <div class=\"feature reveal\"><div class=\"f-ic\">\u26e8</div><h3>Data sovereignty, literally</h3><p>The platform deploys as desktop software on your infrastructure. National geoscience data never leaves your control - no cloud upload, no foreign servers, no exceptions.</p></div>\n      <div class=\"feature reveal\"><div class=\"f-ic\">\u26cf</div><h3>Legacy data becomes an asset</h3><p>Decades of survey archives - geophysics, geochemistry, mapping - are re-read together against current deposit science. The cheapest exploration is the data you already own.</p></div>\n      <div class=\"feature reveal\"><div class=\"f-ic\">\u2696</div><h3>Block allocation, informed</h3><p>Rank ground before you license it. Multi-evidence prospectivity gives licensing rounds and block allocation a defensible technical basis.</p></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section section-alt\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">Program structure</p>\n      <h2>Four phases. Capability transfers in all of them.</h2>\n    </div>\n    <div class=\"steps\">\n      <div class=\"step reveal\"><div class=\"s-num\"></div><div><p class=\"s-when\">Months 1-2</p><h3>Baseline data audit</h3><p>Inventory and quality assessment of national datasets - what exists, what is usable, what gaps matter. Delivered as a published, citable audit.</p></div></div>\n      <div class=\"step reveal\"><div class=\"s-num\"></div><div><p class=\"s-when\">Months 2-6</p><h3>Regional prospectivity scan</h3><p>Country- or province-scale multi-evidence scoring across the commodity systems that matter to your mineral policy. Satellite coverage fills where ground data is thin.</p></div></div>\n      <div class=\"step reveal\"><div class=\"s-num\"></div><div><p class=\"s-when\">Months 6-12</p><h3>District targeting</h3><p>Priority districts re-scored at higher resolution with full deposit-model treatment, producing ranked target portfolios for licensing or state exploration.</p></div></div>\n      <div class=\"step reveal\"><div class=\"s-num\"></div><div><p class=\"s-when\">Throughout</p><h3>Capacity transfer</h3><p>Your geologists work inside the system from month one - structured training, documented workflows, and a skills-development track record we have run for national agencies before. The capability stays when the contract ends.</p></div></div>\n    </div>\n    <p class=\"indicative-note\">Programs are structured to tender requirements - typically multi-year, milestone-based, with deliverables and training quotas contractually defined.</p>\n  </div>\n</section>\n\n<section class=\"section\">\n  <div class=\"wrap-narrow center\">\n    <p class=\"eyebrow\">Engage</p>\n    <h2>Begin with a pilot district.</h2>\n    <p class=\"lead\" style=\"margin:1em auto 2em\">The fastest way to evaluate AiRE is a bounded pilot: one district, your existing data, full methodology disclosure. Judge the program on its output.</p>\n    <a class=\"btn btn-gold\" href=\"/engage\">Discuss a pilot program <span class=\"arr\">\u2192</span></a>\n  </div>\n</section>\n</main>\n\n<div class=\"spine-band\"><div class=\"wrap\"><p class=\"spine\">We don&rsquo;t add to your data pile - we <span class=\"hl\">resolve it into a ranked drill decision you can sign and defend.</span></p></div></div>\n\n";
---
<V5Layout title={title} description={description}>
<Fragment set:html={bodyHtml} />
</V5Layout>
