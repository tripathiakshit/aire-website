---
import PageLayout from '../layouts/PageLayout.astro';

const stats = [
  { n: 30, suffix: '+', label: 'years finding minerals in the field' },
  { n: 5, suffix: '', label: 'continents of exploration experience' },
  { n: 12, suffix: '', label: 'deposit models, calibrated to peer-reviewed literature' },
  { n: 220, suffix: '+', label: 'automated tests — every release reproduces the same answer' },
];
const disciplines = [
  { h: 'No weight without citation', p: 'Every parameter in every deposit model traces to published, peer-reviewed science. No exceptions, no folklore.' },
  { h: 'One seat exists to refute the rest', p: "Nothing ships until the council's adversarial auditor has stress-tested every conclusion for false positives — and failed to break it." },
  { h: 'Project memory that compounds', p: 'The council keeps an append-only record of your geology, your data and every decision — across sessions and across years.' },
];
const doors = [
  { route: '/explorer', kicker: '/explorer', h: 'Miners & juniors', p: 'Where to drill next — and what it costs. Shorten the discovery cycle and turn the data you already paid for into your next drill program.', cta: 'Enter as a miner' },
  { route: '/government', kicker: '/government', h: 'Governments, sovereign wealth & development banks', p: 'De-risk exploration at national scale — regional prospectivity mapping that draws investment into your critical and strategic minerals, with full data sovereignty.', cta: 'Enter as a program' },
  { route: '/investor', kicker: '/investor', h: 'Investors & financial institutions', p: 'Rank the assets in your portfolio on technical merit — which holdings are genuinely prospective, where the risk sits, and which would gain most from a CAGE-IN run.', cta: 'Enter as an investor' },
];
---

<PageLayout
  title="AiRE — Subsurface intelligence that evolves with the science"
  description="AiRE re-reads the exploration data you already own against current, peer-reviewed deposit science — and returns ranked, evidence-traced targets. Your data. Today's tech. Tomorrow's targets."
>
  <!-- HERO -->
  <section class="py-14 md:py-20">
    <div class="mx-auto grid w-[min(1140px,90vw)] items-center gap-10 md:grid-cols-2">
      <div>
        <p class="v5-eyebrow">From a fire-hose of evidence to one defensible decision</p>
        <h1 class="mt-3 font-fraunces text-4xl font-medium leading-[1.08] text-ink sm:text-5xl dark:text-canvas">
          The best-evidenced bet you&rsquo;ll take to the board.
        </h1>
        <p class="mt-3 font-fraunces text-lg italic text-copper dark:text-copper-soft">Your data. Today&rsquo;s tech. Tomorrow&rsquo;s targets.</p>
        <p class="v5-lead mt-5">
          AiRE resolves the exploration data you already own — satellite imagery, geophysics, geochemistry, drilling —
          into a ranked, evidence-traced target list: every weight cited, every gap disclosed. You stay in command of
          every call — the model shows its work; your geologist signs.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a class="v5-btn-gold" href="/engage">Get the 48-Hour Prospect Brief <span aria-hidden="true">→</span></a>
          <a class="v5-link text-sm" href="/viewer.html">or fly an interactive 3D model first →</a>
        </div>
      </div>
      <figure data-reveal>
        <img
          src="/assets/regional_priority_map.webp"
          alt="Illustrative 3D prospectivity terrain model — synthetic ranked targets and geological structures draped over terrain"
          class="w-full rounded-xl border border-line shadow-sm dark:border-ink-2"
          width="1600" height="900" loading="eager"
        />
        <figcaption class="mt-2 text-xs italic text-text-soft">
          Illustrative model only — synthetic targets on a distorted terrain, not real project data. The drill-proven program is below.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- PROOF STRIP -->
  <div class="bg-ink text-canvas">
    <div class="mx-auto w-[min(1140px,90vw)] py-8">
      <p class="text-canvas/90">
        <strong class="text-cage-gold-soft">Drill-proven.</strong> On a live East African nickel program, CAGE-IN-ranked
        targets were drill-tested and returned confirmed nickel mineralization — carried from raw archives to the rig.
        <a class="font-semibold text-geo-secondary underline-offset-2 hover:underline" href="/case-studies">See the flagship case →</a>
      </p>
      <div class="mt-4 flex flex-wrap gap-x-8 gap-y-2 text-sm text-canvas/70">
        <span><b class="text-canvas">308</b> ranked target polygons</span>
        <span><b class="text-canvas">13</b> evidence layers</span>
        <span><b class="text-canvas">167</b> geochem analytes</span>
        <span><b class="text-canvas">100%</b> of coverage gaps disclosed</span>
      </div>
    </div>
  </div>

  <!-- STAT STRIP -->
  <div class="border-y border-line bg-canvas-alt dark:border-ink-2 dark:bg-ink-2/40">
    <div class="mx-auto grid w-[min(1140px,90vw)] grid-cols-2 gap-6 py-10 md:grid-cols-4">
      {stats.map((s) => (
        <div>
          <div class="font-fraunces text-4xl font-semibold text-cage-gold-deep dark:text-cage-gold-soft">
            <span data-count-to={s.n} data-count-suffix={s.suffix}>{s.n}{s.suffix}</span>
          </div>
          <div class="mt-1 text-sm text-text-soft">{s.label}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- TRUST BAND + DECISION FILTER -->
  <section class="py-16 md:py-24">
    <div class="mx-auto w-[min(1140px,90vw)]">
      <p class="v5-eyebrow">Why you can trust a score from us</p>
      <h2 class="v5-h2 mt-2">Not a black box. A score you can audit.</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        <div class="v5-card" data-reveal><h4 class="font-fraunces text-lg text-ink dark:text-canvas">Every weight is cited</h4><p class="mt-2 text-sm text-text-soft">Each parameter in every deposit model traces to peer-reviewed literature — no folklore, no unexplained weighting.</p></div>
        <div class="v5-card" data-reveal><h4 class="font-fraunces text-lg text-ink dark:text-canvas">Every gap is named</h4><p class="mt-2 text-sm text-text-soft">The coverage disclosure shows exactly what your data could not see — the dark layers are on the page, not hidden.</p></div>
        <div class="v5-card" data-reveal><h4 class="font-fraunces text-lg text-ink dark:text-canvas">A named geologist signs</h4><p class="mt-2 text-sm text-text-soft">A <a class="v5-link" href="/council">seasoned explorer</a> takes charge and signs off on every report. The model shows its work; you make the call.</p></div>
      </div>
      <p class="mt-6 text-text-soft">Most AI-prospectivity tools bolt an explanation onto a black box. Here the explanation <em>is</em> the model — every score is traceable to a cited weight and a disclosed gap by construction.</p>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="flex items-center justify-between gap-3 rounded-lg border border-line px-4 py-3 dark:border-ink-2"><span class="text-sm font-medium text-ink dark:text-canvas">Where do I drill?</span><a class="text-xs font-semibold text-copper dark:text-copper-soft" href="/case-studies">ranked targets →</a></div>
        <div class="flex items-center justify-between gap-3 rounded-lg border border-line px-4 py-3 dark:border-ink-2"><span class="text-sm font-medium text-ink dark:text-canvas">How sure are we?</span><a class="text-xs font-semibold text-copper dark:text-copper-soft" href="/case-studies">cited weights →</a></div>
        <div class="flex items-center justify-between gap-3 rounded-lg border border-line px-4 py-3 dark:border-ink-2"><span class="text-sm font-medium text-ink dark:text-canvas">What can&rsquo;t the data see?</span><a class="text-xs font-semibold text-copper dark:text-copper-soft" href="/methodology">coverage disclosure →</a></div>
        <div class="flex items-center justify-between gap-3 rounded-lg border border-line px-4 py-3 dark:border-ink-2"><span class="text-sm font-medium text-ink dark:text-canvas">Cost &amp; speed?</span><a class="text-xs font-semibold text-copper dark:text-copper-soft" href="/engage">48 hours, fixed scope →</a></div>
      </div>
    </div>
  </section>

  <!-- BUILDER'S STORY -->
  <section class="border-t border-line bg-canvas-alt py-16 md:py-24 dark:border-ink-2 dark:bg-ink-2/40">
    <div class="mx-auto grid w-[min(1140px,90vw)] items-start gap-10 md:grid-cols-2">
      <div data-reveal class="overflow-hidden rounded-xl border border-line bg-ink dark:border-ink-2">
        <iframe src="/hook-video/index.html" title="CAGE-IN — why AiRE exists (90-second hook video)" loading="lazy" class="block aspect-video w-full border-0"></iframe>
      </div>
      <div>
        <p class="v5-eyebrow">The builder&rsquo;s story</p>
        <h2 class="v5-h2 mt-2">Thirty years in the field. One conclusion: the software wasn&rsquo;t keeping up.</h2>
        <p class="mt-4 text-text-soft">Dr. Amit Tripathi spent three decades finding minerals the hard way — mapping, drilling and modeling across twenty countries on five continents. On every project he watched the same quiet failure: the science of ore deposits kept advancing, paper by paper, while the software interpreting exploration data stayed frozen at whatever the vendor shipped.</p>
        <p class="mt-3 text-text-soft">So he built what didn&rsquo;t exist: a live, GPU-accelerated targeting platform whose deposit models are calibrated to peer-reviewed literature and updated as the science moves — guarded by more than 220 automated regression tests, and proven on live exploration programs.</p>
        <blockquote class="mt-5 border-l-2 border-copper pl-4">
          <p class="font-fraunces text-lg italic text-ink dark:text-canvas">&ldquo;Every drill hole is a bet on an interpretation. I built CAGE-IN to make that bet the best-informed one on the table.&rdquo;</p>
          <p class="mt-1 text-sm text-text-soft">Dr. Amit Tripathi · Founder, AiRE</p>
        </blockquote>
        <div class="mt-5 flex flex-wrap gap-2">
          {['PhD, Structural Geology', '30+ years in exploration', '22+ publications', '20+ countries'].map((c) => (
            <span class="rounded-full border border-line px-3 py-1 text-xs font-medium text-text-soft dark:border-ink-2">{c}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- DATA INTAKE — the 80% reality -->
  <section class="py-16 md:py-24">
    <div class="mx-auto w-[min(1140px,90vw)]">
      <p class="v5-eyebrow">The 80% reality</p>
      <h2 class="v5-h2 mt-2">We don&rsquo;t expect clean data. Clean exploration data doesn&rsquo;t exist.</h2>
      <p class="v5-lead mt-4 max-w-3xl">Most of the work in modern targeting is not the algorithm — it is the wrangling. Legacy MapInfo files, drill logs scanned to PDF, coordinate systems from 1994: that is where exploration programs lose their months, and it is where we start.</p>
      <blockquote class="mt-6 border-l-2 border-copper pl-4">
        <p class="font-fraunces text-xl italic text-ink dark:text-canvas">&ldquo;Bring us your absolute worst folder.&rdquo;</p>
        <p class="mt-1 text-sm text-text-soft">Mismatched datums, legacy geophysics, raw drill intercepts, unindexed geochemistry — the intake pipeline is built for the archive you actually have, not the database you wish you had.</p>
      </blockquote>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        <div class="v5-card" data-reveal><div class="font-fraunces text-2xl text-copper dark:text-copper-soft">01</div><h3 class="mt-2 font-fraunces text-lg text-ink dark:text-canvas">Custom geo-data automation</h3><p class="mt-2 text-sm text-text-soft">Proprietary scripts ingest the structured majority — standardising datum projections, cleaning spatial coordinates and normalising assay detection limits across multi-year campaigns.</p><span class="mt-3 block text-xs font-semibold text-cage-gold-deep dark:text-cage-gold-soft">Months of spreadsheet alignment, eliminated.</span></div>
        <div class="v5-card" data-reveal><div class="font-fraunces text-2xl text-copper dark:text-copper-soft">02</div><h3 class="mt-2 font-fraunces text-lg text-ink dark:text-canvas">Language-model parsing</h3><p class="mt-2 text-sm text-text-soft">Specialised language-model pipelines read the &ldquo;dark data&rdquo; standard software ignores — scanned PDFs, unindexed drill logs, legacy structural reports — converting field notes into quantifiable spatial attributes.</p><span class="mt-3 block text-xs font-semibold text-cage-gold-deep dark:text-cage-gold-soft">Value recovered from forgotten paper archives.</span></div>
        <div class="v5-card border-cage-gold dark:border-cage-gold/60" data-reveal><div class="font-fraunces text-2xl text-copper dark:text-copper-soft">03</div><h3 class="mt-2 font-fraunces text-lg text-ink dark:text-canvas">Geologist audit</h3><p class="mt-2 text-sm text-text-soft">The safety catch. Every automated and language-model output is audited by an experienced exploration geologist before it reaches the targeting engine — checked at the rock level.</p><span class="mt-3 block text-xs font-semibold text-cage-gold-deep dark:text-cage-gold-soft">Human scrutiny before anything is scored.</span></div>
      </div>
    </div>
  </section>

  <!-- COUNCIL TEASER -->
  <section class="border-t border-line bg-canvas-alt py-16 md:py-24 dark:border-ink-2 dark:bg-ink-2/40">
    <div class="mx-auto w-[min(1140px,90vw)]">
      <p class="v5-eyebrow">The AiRE Council</p>
      <h2 class="v5-h2 mt-2">You don&rsquo;t hire a consultant. You engage a council.</h2>
      <p class="v5-lead mt-4 max-w-3xl">AiRE is led by a deep bench of senior exploration geologists and specialists spanning five continents. A named, qualified geologist — Dr.&nbsp;Tripathi — governs every project and signs every verdict. Working alongside that human team, a standing council of role-titled AI agents does the tireless work — stress-testing every target and citing every weight before anything ships. The model shows its work; your geologist makes the call.</p>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {disciplines.map((d) => (
          <div class="v5-card" data-reveal><h4 class="font-fraunces text-lg text-ink dark:text-canvas">{d.h}</h4><p class="mt-2 text-sm text-text-soft">{d.p}</p></div>
        ))}
      </div>
      <p class="mt-8"><a class="v5-link" href="/council">Meet the human bench and the full council →</a></p>
    </div>
  </section>

  <!-- DELIVERABLES -->
  <section class="py-16 md:py-24">
    <div class="mx-auto w-[min(1140px,90vw)]">
      <p class="v5-eyebrow">Outputs, not inputs</p>
      <h2 class="v5-h2 mt-2">Judge us by the deliverables.</h2>
      <p class="v5-lead mt-4 max-w-3xl">Credentials are inputs. These are outputs — sanitized examples of what lands on your desk at the end of an AiRE engagement. Project names, locations and client identifiers removed; the substance intact.</p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        <article class="overflow-hidden rounded-xl border border-line dark:border-ink-2" data-reveal>
          <video src="/assets/regional_targets_rotation.mp4" poster="/assets/regional_targets_rotation_poster.jpg" muted loop playsinline preload="metadata" class="block aspect-[4/3] w-full bg-ink object-cover" aria-label="Rotating 3D terrain view of ranked exploration targets"></video>
          <div class="bg-surface p-5 dark:bg-ink-2"><h3 class="font-fraunces text-lg text-ink dark:text-canvas">Ranked prospectivity maps</h3><p class="mt-2 text-sm text-text-soft">Multi-evidence score rasters with graded drill targets — every score traceable to the evidence layers, deposit model and literature behind it.</p><span class="mt-3 block text-xs font-medium text-copper dark:text-copper-soft">Greenfield nickel program · 308 ranked polygons from 13 evidence layers</span></div>
        </article>
        <article class="overflow-hidden rounded-xl border border-line dark:border-ink-2" data-reveal>
          <video src="/assets/deposit3d_rotation_drilling.mp4" poster="/assets/deposit3d_rotation_drilling_poster.jpg" muted loop playsinline preload="metadata" class="block aspect-[4/3] w-full bg-ink object-cover" aria-label="Rotating 3D deposit model with drill traces"></video>
          <div class="bg-surface p-5 dark:bg-ink-2"><h3 class="font-fraunces text-lg text-ink dark:text-canvas">Interactive 3D deposit models</h3><p class="mt-2 text-sm text-text-soft">Single-file 3D viewers your whole board can open — fly through the orebody, inspect every drill intercept. No software, no login, works offline.</p><span class="mt-3 block text-xs font-medium text-copper dark:text-copper-soft">3D large polymetallic deposit model</span></div>
        </article>
      </div>
      <div class="mt-8 flex flex-col items-center gap-2">
        <a class="v5-btn-line" href="/viewer.html">Fly the 3D Deposit Demo <span aria-hidden="true">→</span></a>
        <p class="text-xs text-text-soft">Instant interactive 3D viewer · no login · runs in your browser, even offline</p>
      </div>
      <p class="mt-8 text-text-soft">Blind tests prove recovery of what is already known; live programs are scored before anyone knows — across nickel, copper-gold, iron ore, polymetallic and more. <a class="v5-link" href="/case-studies">See the documented case studies →</a></p>
      <p class="mt-3 text-xs text-text-soft">Sanitized for confidentiality — nothing here is a disclosure of exploration results or mineral resources under NI&nbsp;43-101 or the JORC Code, and no economic potential is implied.</p>
    </div>
  </section>

  <!-- USE-CASE TEASER -->
  <section class="border-t border-line bg-canvas-alt py-16 md:py-24 dark:border-ink-2 dark:bg-ink-2/40">
    <div class="mx-auto w-[min(1140px,90vw)] text-center">
      <p class="v5-eyebrow">Use cases</p>
      <h2 class="v5-h2 mt-2">One engine, every stage of the hunt.</h2>
      <p class="v5-lead mx-auto mt-4 max-w-2xl">From grassroots ground to a producing mine, CAGE-IN solves a different problem at each stage of exploration — reconnaissance, targeting, optimisation, and resource expansion.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-2">
        {['Reconnaissance', 'Targeting', 'Optimisation', 'Resource expansion'].map((c) => (
          <span class="rounded-full border border-line bg-surface px-4 py-1.5 text-sm font-medium text-ink dark:border-ink-2 dark:bg-ink-2 dark:text-canvas">{c}</span>
        ))}
      </div>
      <p class="mt-6"><a class="v5-link" href="/technology#use-cases">See how CAGE-IN plugs in at each stage →</a></p>
    </div>
  </section>

  <!-- DOORS -->
  <section class="bg-ink py-16 text-canvas md:py-24">
    <div class="mx-auto w-[min(1140px,90vw)]">
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-cage-gold-soft">Choose your door</p>
      <h2 class="mt-2 font-fraunces text-3xl font-medium md:text-4xl">Three ways in.</h2>
      <p class="mt-4 max-w-3xl text-canvas/70">Miners, national programs and investors come to AiRE with different questions. Each gets its own door — and its own straight answer.</p>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {doors.map((d) => (
          <article class="flex flex-col rounded-xl border border-white/10 bg-white/[0.03] p-6" data-reveal>
            <p class="font-mono text-xs text-cage-gold-soft">{d.kicker}</p>
            <h3 class="mt-2 font-fraunces text-xl">{d.h}</h3>
            <p class="mt-2 flex-1 text-sm text-canvas/70">{d.p}</p>
            <a class="mt-5 inline-flex items-center gap-2 self-start rounded-md border border-white/20 px-4 py-2 text-sm font-semibold text-canvas transition-colors hover:bg-white/10" href={d.route}>{d.cta} <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- GEOLOGIST TO GEOLOGIST -->
  <section class="py-16 md:py-24">
    <div class="mx-auto w-[min(860px,90vw)]">
      <p class="v5-eyebrow">Geologist to geologist</p>
      <h2 class="v5-h2 mt-2">Have messy historical data? Let&rsquo;s look at it together.</h2>
      <p class="v5-lead mt-4">Junior budgets are tight and drilling windows close fast. If you want to know whether your legacy geophysics, geochemistry or drill archives can support an AiRE run, skip the contact form and write to the founder directly.</p>
      <div class="mt-6 flex flex-col items-start justify-between gap-5 rounded-xl border border-line bg-surface p-6 sm:flex-row sm:items-center dark:border-ink-2 dark:bg-ink-2" data-reveal>
        <div>
          <strong class="text-ink dark:text-canvas">Dr. Amit Tripathi</strong>
          <p class="text-sm text-text-soft">PhD, Structural Geology · 30 years in the field</p>
          <p class="mt-1 text-xs text-text-soft">NDA first. Data rooms, not email attachments. Answered personally within two business days.</p>
        </div>
        <a class="v5-btn-gold shrink-0" href="mailto:info@geoexplorationllc.com?subject=Prospect%20Brief%20request%20-%20legacy%20data%20review">Email Amit directly <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- SPINE -->
  <div class="border-t border-line bg-canvas-alt dark:border-ink-2 dark:bg-ink-2/40">
    <div class="mx-auto w-[min(1140px,90vw)] py-10">
      <p class="font-fraunces text-xl text-ink dark:text-canvas">We don&rsquo;t add to your data pile — we <span class="text-copper dark:text-copper-soft">resolve it into a ranked drill decision you can sign and defend.</span></p>
    </div>
  </div>
</PageLayout>
