---
import V5Layout from '../layouts/V5Layout.astro';
const title = "For Investors & Financial Institutions - rank your portfolio on technical merit | AiRE";
const description = "Independent, evidence-traced prospectivity review for investors, funds and lenders: rank the exploration assets you hold on technical merit, see where the risk sits, and find which would benefit most from a CAGE-IN run. White-label available.";
const bodyHtml = "\n\n<main>\n<section class=\"page-hero\">\n  <div class=\"wrap\">\n    <p class=\"eyebrow\">/investor \u00b7 for investors &amp; financial institutions</p>\n    <h1>Rank the technical merit of every asset in your portfolio.</h1>\n    <p class=\"lead\">AiRE gives investors, funds and lenders an independent, evidence-traced read on the exploration assets they hold or are weighing - which ground is genuinely prospective, where the technical risk actually sits, and which projects would gain the most from a CAGE-IN run.</p>\n  </div>\n</section>\n\n<section class=\"section\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">The problem we solve</p>\n      <h2>Exploration risk you&rsquo;re carrying, but can&rsquo;t see.</h2>\n      <p class=\"lead\">Portfolios get ranked by promoters&rsquo; decks, not by independent technical evidence. AiRE re-reads the data underneath each asset - the same multi-evidence, literature-cited engine behind every AiRE result - and tells you what the rocks actually support.</p>\n    </div>\n    <div class=\"feature-cols\">\n      <div class=\"feature reveal\"><div class=\"f-ic\">\u25e7</div><h3>Portfolio-wide prospectivity review</h3><p>We run the datasets behind each holding through CAGE-IN and return a comparable, evidence-traced prospectivity read across the whole book - one standard, applied to every asset.</p></div>\n      <div class=\"feature reveal\"><div class=\"f-ic\">\u2696</div><h3>Asset ranking &amp; technical risk</h3><p>Holdings ranked on technical merit, with the coverage disclosure naming exactly what each project&rsquo;s data could not test - so the risk is on the page, not buried in a footnote.</p></div>\n      <div class=\"feature reveal\"><div class=\"f-ic\">\u25c8</div><h3>Where CAGE-IN adds the most</h3><p>We flag the assets most likely to benefit from a full CAGE-IN run - where re-reading the data could grow a resource, define new targets, or de-risk the next raise.</p></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section section-alt\">\n  <div class=\"wrap-narrow\">\n    <p class=\"eyebrow\">What we review</p>\n    <h2>Bring us the data room. We read what the deck won&rsquo;t tell you.</h2>\n    <div class=\"steps\">\n      <div class=\"step reveal\"><div class=\"s-num\"></div><div><h3>The technical datasets</h3><p>Geophysics, geochemistry, drilling, imagery and reports across the assets you hold or are evaluating - in whatever state they exist.</p></div></div>\n      <div class=\"step reveal\"><div class=\"s-num\"></div><div><h3>Independent and conflict-free</h3><p>AiRE holds no position in your assets. The read is a technical opinion, not a promotion - the same discipline we apply to our own programs, with every weight cited and every gap named.</p></div></div>\n      <div class=\"step reveal\"><div class=\"s-num\"></div><div><h3>Confidential by default</h3><p>NDA first; data rooms, not email attachments. Nothing appears in our materials without written consent, and credentials never live in our code or outputs.</p></div></div>\n    </div>\n    <p class=\"indicative-note\"><b>White-label &amp; QP licensing.</b> Where you need the analysis to carry your own brand - or a Qualified Person&rsquo;s sign-off - AiRE runs white-label: the methodology is documented generically, and the deliverable is yours alone.</p>\n    <div class=\"fly-cta\">\n      <a class=\"btn btn-gold\" href=\"/contact#book-call\">Talk through your portfolio <span class=\"arr\">\u2192</span></a>\n      <p class=\"micro\">A confidential, independent technical read - under NDA</p>\n    </div>\n  </div>\n</section>\n</main>\n\n<div class=\"spine-band\"><div class=\"wrap\"><p class=\"spine\">We don&rsquo;t add to your data pile - we <span class=\"hl\">resolve it into a ranked drill decision you can sign and defend.</span></p></div></div>\n\n";
---
<V5Layout title={title} description={description}>
<Fragment set:html={bodyHtml} />
</V5Layout>
