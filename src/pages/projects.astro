<V5Layout title={title} description={description}>
<style is:global>

/* projects-page only: evidence-fusion pentagon (replaces the old gradient bars).
   Five evidence streams converge into one ranked score - meaningful, not decorative.
   Nodes/labels positioned by JS; authored positions below keep it correct with no JS. */
.ev-fusion { display:block; width:100%; max-width:720px; margin:1.6rem auto .4rem; height:auto; overflow:visible; }
.ev-spoke { stroke:#d8c9b0; stroke-width:1.4; }
.ev-node { stroke:#fff; stroke-width:1.6; }
.ev-hub { fill:#10202b; }
.ev-hub-t1, .ev-hub-t2 { fill:#fff; text-anchor:middle; font-family:"Fraunces",Georgia,serif; }
.ev-hub-t1 { font-size:13px; } .ev-hub-t2 { font-size:13px; font-weight:600; }
.ev-label { font-family:"Inter",sans-serif; font-size:13.5px; font-weight:600; fill:#5a5246; dominant-baseline:middle; }

</style>
<Fragment set:html={bodyHtml} />
<script is:inline>

(function(){
  // spectrum bars: animate from 0 -> inline width (no-JS keeps final width)
  var bars=document.querySelectorAll('.cap-spectrum .spec-bar span');
  bars.forEach(function(s){ var w=s.style.width; s.style.width='0'; requestAnimationFrame(function(){ requestAnimationFrame(function(){ s.style.width=w; }); }); });
  // ledger sort
  var ledger=document.getElementById('ledger');
  if(ledger){
    var rows=Array.prototype.slice.call(ledger.querySelectorAll('.lrow'));
    var order=rows.slice();
    document.querySelectorAll('.lc-btn').forEach(function(b){
      b.addEventListener('click',function(){
        document.querySelectorAll('.lc-btn').forEach(function(x){x.classList.remove('is-on');});
        b.classList.add('is-on');
        var k=b.dataset.sort, arr;
        if(k==='default'){ arr=order; }
        else { arr=rows.slice().sort(function(p,q){ return p.dataset[k].localeCompare(q.dataset[k]); }); }
        arr.forEach(function(r){ ledger.appendChild(r); });
      });
    });
  }

  // de-overlap pass: nudge near-coincident map markers apart into a tidy bead
  // cluster (deterministic relaxation) so dense countries - India (13), DR Congo,
  // Australia, Madagascar, Morocco - read as distinct, clickable dots, not a blob.
  // Centroid of each cluster is preserved, so geography stays generalized, not moved.
  (function deOverlap(){
    var map=document.querySelector('svg.wmap'); if(!map) return;
    var nodes=[];
    map.querySelectorAll('.wmap-dots circle[data-c]').forEach(function(c){
      nodes.push({el:c, ring:null, x:+c.getAttribute('cx'), y:+c.getAttribute('cy'), r:+c.getAttribute('r')});
    });
    map.querySelectorAll('.wmap-flags circle[data-c]').forEach(function(c){
      var prev=c.previousElementSibling;
      var ring=(prev&&prev.classList&&prev.classList.contains('wm-ring'))?prev:null;
      // flags space by their ring radius so the dark rings don't overlap either
      var rr=ring?+ring.getAttribute('r'):+c.getAttribute('r');
      nodes.push({el:c, ring:ring, x:+c.getAttribute('cx'), y:+c.getAttribute('cy'), r:rr});
    });
    // break exact-coincident stacks deterministically (golden-angle micro-offset by index)
    var GA=2.399963229728653;
    nodes.forEach(function(n,i){ n.x+=Math.cos(i*GA)*0.01; n.y+=Math.sin(i*GA)*0.01; });
    var GAP=2.8, PASSES=90;
    for(var p=0;p<PASSES;p++){
      for(var i=0;i<nodes.length;i++){
        for(var j=i+1;j<nodes.length;j++){
          var a=nodes[i], b=nodes[j];
          var dx=b.x-a.x, dy=b.y-a.y, d=Math.hypot(dx,dy)||0.001;
          var min=a.r+b.r+GAP;
          if(d<min){
            var push=(min-d)/2, ux=dx/d, uy=dy/d;
            a.x-=ux*push; a.y-=uy*push;
            b.x+=ux*push; b.y+=uy*push;
          }
        }
      }
    }
    nodes.forEach(function(n){
      var x=n.x.toFixed(2), y=n.y.toFixed(2);
      n.el.setAttribute('cx',x); n.el.setAttribute('cy',y);
      if(n.ring){ n.ring.setAttribute('cx',x); n.ring.setAttribute('cy',y); }
    });
  })();

  // evidence-fusion pentagon: the five nodes orbit the hub as you scroll (rotation
  // tracks scroll position, so it spins faster the faster you scroll). Labels are
  // re-placed upright and outside each node every frame, so nothing is misrepresented
  // and nothing turns upside-down. Honours prefers-reduced-motion (stays static).
  (function evFusion(){
    var ev=document.querySelector('.ev-fusion'); if(!ev) return;
    var CX=300, CY=190, R=106, LR=164, base=[-90,-18,54,126,198];
    var nodes=ev.querySelectorAll('.ev-node'),
        spokes=ev.querySelectorAll('.ev-spoke'),
        labels=ev.querySelectorAll('.ev-label');
    // labels keep a fixed centre anchor (no anchor-flip snapping); geometry is tuned
    // so a centred label always clears its node.
    function place(rot){
      for(var i=0;i<base.length;i++){
        var a=(base[i]+rot)*Math.PI/180, ca=Math.cos(a), sa=Math.sin(a);
        var nx=CX+R*ca, ny=CY+R*sa, lx=CX+LR*ca, ly=CY+LR*sa;
        nodes[i].setAttribute('cx',nx.toFixed(2)); nodes[i].setAttribute('cy',ny.toFixed(2));
        spokes[i].setAttribute('x2',nx.toFixed(2)); spokes[i].setAttribute('y2',ny.toFixed(2));
        labels[i].setAttribute('x',lx.toFixed(2)); labels[i].setAttribute('y',ly.toFixed(2));
      }
    }
    var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(reduce){ return; }   // authored static pentagon already correct
    // Continuous eased rAF loop: rotation glides toward the scroll-derived target
    // instead of jumping in big discrete steps per scroll event - kills the skipping.
    var target=window.scrollY*0.09, cur=target, running=false;
    function tick(){
      var d=target-cur;
      if(Math.abs(d)<0.03){ cur=target; place(cur); running=false; return; }
      cur+=d*0.16;
      place(cur);
      requestAnimationFrame(tick);
    }
    function onScroll(){
      target=window.scrollY*0.09;
      if(!running){ running=true; requestAnimationFrame(tick); }
    }
    place(cur);
    window.addEventListener('scroll', onScroll, {passive:true});
  })();

  // world-map popup balloon: click a point -> country / commodity / deposit style;
  // any other activity on the page hides it.
  var svg=document.querySelector('svg.wmap');
  var wrap=document.querySelector('.wmap-wrap');
  var bal=document.querySelector('.wm-balloon');
  if(svg&&wrap&&bal){
    var open=false;
    function hide(){ if(open){ open=false; bal.hidden=true; } }
    function show(circle){
      var c=circle.getAttribute('data-c')||'', m=circle.getAttribute('data-m')||'', s=circle.getAttribute('data-s')||'';
      var html='<b>'+c+'</b><span class="wm-b-comm">'+m+'</span><span class="wm-b-style">'+s+'</span>';
      if(circle.getAttribute('data-f')==='1') html+='<span class="wm-b-flag">CAGE-IN Platform Flagship</span>';
      bal.innerHTML=html; bal.hidden=false; open=true;
      var wr=wrap.getBoundingClientRect(), cr=circle.getBoundingClientRect();
      var cx=cr.left-wr.left+cr.width/2, cy=cr.top-wr.top;
      var bw=bal.offsetWidth, bh=bal.offsetHeight, pad=6;
      var left=Math.max(pad, Math.min(cx-bw/2, wrap.clientWidth-bw-pad));
      var top=cy-bh-10, below=false;
      if(top<pad){ top=cy+14; below=true; }
      bal.style.left=left+'px'; bal.style.top=top+'px';
      bal.classList.toggle('below', below);
      bal.style.setProperty('--tip', Math.max(10, Math.min(cx-left, bw-10))+'px');
    }
    svg.addEventListener('click', function(e){
      var t=e.target;
      if(t&&t.tagName==='circle'&&t.hasAttribute('data-c')){ e.stopPropagation(); show(t); }
      else hide();
    });
    document.addEventListener('click', function(e){ if(!svg.contains(e.target)) hide(); });
    window.addEventListener('scroll', hide, {passive:true});
    window.addEventListener('resize', hide);
    window.addEventListener('keydown', hide);
  }
})();

</script>
</V5Layout>
