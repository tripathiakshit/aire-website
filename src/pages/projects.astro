-c=\"French Guiana\" data-m=\"Gold\" data-s=\"Orogenic\"/>\n  </g>\n  <g class=\"wmap-flags\">\n    <circle class=\"wm-ring\" cx=\"556.2\" cy=\"254.4\" r=\"7.2\" fill=\"none\"/>\n    <circle cx=\"556.2\" cy=\"254.4\" r=\"4.3\" fill=\"#3d7a52\" data-c=\"East Africa\" data-m=\"Nickel\" data-s=\"Supergene laterite\" data-f=\"1\"/>\n    <circle class=\"wm-ring\" cx=\"236.4\" cy=\"243.6\" r=\"7.2\" fill=\"none\"/>\n    <circle cx=\"236.4\" cy=\"243.6\" r=\"4.3\" fill=\"#9a5630\" data-c=\"Colombia\" data-m=\"Copper-gold\" data-s=\"Porphyry\" data-f=\"1\"/>\n    <circle class=\"wm-ring\" cx=\"253.2\" cy=\"92.1\" r=\"7.2\" fill=\"none\"/>\n    <circle cx=\"253.2\" cy=\"92.1\" r=\"4.3\" fill=\"#6b4fa0\" data-c=\"Northern Ontario, Canada\" data-m=\"Uranium-REE\" data-s=\"Paleoplacer (QPC)\" data-f=\"1\"/>\n    <circle class=\"wm-ring\" cx=\"153.3\" cy=\"121.1\" r=\"7.2\" fill=\"none\"/>\n    <circle cx=\"153.3\" cy=\"121.1\" r=\"4.3\" fill=\"#b58a1f\" data-c=\"Nevada, USA\" data-m=\"Gold\" data-s=\"Carlin-type &amp; epithermal\" data-f=\"1\"/>\n    <circle class=\"wm-ring\" cx=\"152.8\" cy=\"112.7\" r=\"7.2\" fill=\"none\"/>\n    <circle cx=\"152.8\" cy=\"112.7\" r=\"4.3\" fill=\"#b58a1f\" data-c=\"Nevada, USA\" data-m=\"Gold\" data-s=\"Orogenic (reconnaissance)\" data-f=\"1\"/>\n    <circle class=\"wm-ring\" cx=\"278.5\" cy=\"83.7\" r=\"7.2\" fill=\"none\"/>\n    <circle cx=\"278.5\" cy=\"83.7\" r=\"4.3\" fill=\"#1f8a8a\" data-c=\"Quebec, Canada\" data-m=\"Graphite\" data-s=\"Metamorphic flake\" data-f=\"1\"/>\n    <circle class=\"wm-ring\" cx=\"447.6\" cy=\"142.5\" r=\"7.2\" fill=\"none\"/>\n    <circle cx=\"447.6\" cy=\"142.5\" r=\"4.3\" fill=\"#1f8a8a\" data-c=\"Morocco\" data-m=\"Antimony\" data-s=\"Vein-hosted (\u00b1 gold)\" data-f=\"1\"/>\n    <circle class=\"wm-ring\" cx=\"444.8\" cy=\"143.6\" r=\"7.2\" fill=\"none\"/>\n    <circle cx=\"444.8\" cy=\"143.6\" r=\"4.3\" fill=\"#9a5630\" data-c=\"Morocco\" data-m=\"Lead-zinc-silver\" data-s=\"Carbonate replacement\" data-f=\"1\"/>\n    <circle class=\"wm-ring\" cx=\"540.7\" cy=\"273.7\" r=\"7.2\" fill=\"none\"/>\n    <circle cx=\"540.7\" cy=\"273.7\" r=\"4.3\" fill=\"#1f8a8a\" data-c=\"DR Congo\" data-m=\"Tin-coltan\" data-s=\"Rare-metal pegmatite\" data-f=\"1\"/>\n    <circle class=\"wm-ring\" cx=\"427.2\" cy=\"225.8\" r=\"7.2\" fill=\"none\"/>\n    <circle cx=\"427.2\" cy=\"225.8\" r=\"4.3\" fill=\"#b5482f\" data-c=\"West Africa\" data-m=\"Iron ore\" data-s=\"Banded iron formation\" data-f=\"1\"/>\n    <circle class=\"wm-ring\" cx=\"675.3\" cy=\"163.1\" r=\"7.2\" fill=\"none\"/>\n    <circle cx=\"675.3\" cy=\"163.1\" r=\"4.3\" fill=\"#9a5630\" data-c=\"India\" data-m=\"Zinc-lead-silver\" data-s=\"SEDEX\" data-f=\"1\"/>\n    <circle class=\"wm-ring\" cx=\"566.8\" cy=\"192.9\" r=\"7.2\" fill=\"none\"/>\n    <circle cx=\"566.8\" cy=\"192.9\" r=\"4.3\" fill=\"#9a5630\" data-c=\"Red Sea Hills\" data-m=\"Copper-zinc\" data-s=\"VMS (polymetallic)\" data-f=\"1\"/>\n  </g>\n</svg>\n      <div class=\"wm-balloon\" hidden aria-live=\"polite\"></div>\n      <div class=\"wmap-legend\">\n        <span class=\"wm-key\"><i style=\"background:#b58a1f\"></i>Gold</span>\n        <span class=\"wm-key\"><i style=\"background:#9a5630\"></i>Copper &amp; base metals</span>\n        <span class=\"wm-key\"><i style=\"background:#b5482f\"></i>Iron ore</span>\n        <span class=\"wm-key\"><i style=\"background:#3d7a52\"></i>Nickel, PGE &amp; chromite</span>\n        <span class=\"wm-key\"><i style=\"background:#6b4fa0\"></i>Uranium &amp; REE</span>\n        <span class=\"wm-key\"><i style=\"background:#2f6f9a\"></i>Diamond (kimberlite)</span>\n        <span class=\"wm-key\"><i style=\"background:#1f8a8a\"></i>Critical &amp; specialty metals</span>\n        <span class=\"wm-key\"><i style=\"background:#9a9488\"></i>Geological advisory</span>\n        <span class=\"wm-key flag\"><i></i>CAGE-IN Platform Flagship</span>\n      </div>\n    </div>\n\n    <div class=\"cap-tiles\" style=\"margin-top:2rem\">\n      <div class=\"cap-tile\"><b>5</b><span>continents</span></div>\n      <div class=\"cap-tile\"><b>60+</b><span>programs</span></div>\n      <div class=\"cap-tile\"><b>20+</b><span>commodities</span></div>\n    </div>\n    <p class=\"cap-note\">Spanning orogenic and Carlin-type gold, porphyry and VMS copper, sediment-hosted and SEDEX base metals, magmatic nickel-PGE-chromite, kimberlite diamond, uranium-REE and the critical metals - across greenfield reconnaissance, brownfield expansion, 3D modeling and independent due diligence. <span class=\"cap-dim\">Markers show where work was done, generalized to map scale; this is a record of exploration and consulting experience, not a statement of Mineral Resources, grades or tonnages.</span></p>\n  </div>\n</section>\n\n<!-- ============ #1 \u00b7 Deployment ledger (drill-down) ============ -->\n<section class=\"section\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">Deployment ledger</p>\n      <h2>One row per flagship deployment.</h2>\n      <p class=\"lead\">Twelve programs carried end to end on the CAGE-IN platform, across the Americas, Africa and Asia. Each row is a deposit style solved by the same pipeline - open one to see the method. Locations are country- or region-level; client, project and exact coordinates are withheld.</p>\n    </div>\n\n    <div class=\"ledger-controls\">\n      <span class=\"lc-label\">Sort</span>\n      <button class=\"lc-btn is-on\" data-sort=\"default\">Default</button>\n      <button class=\"lc-btn\" data-sort=\"region\">Continent</button>\n      <button class=\"lc-btn\" data-sort=\"commodity\">Commodity</button>\n      <button class=\"lc-btn\" data-sort=\"style\">Deposit style</button>\n    </div>\n\n    <div class=\"ledger\" id=\"ledger\">\n      <div class=\"ledger-head\" aria-hidden=\"true\">\n        <span>Location</span><span>Status</span><span>Commodity</span><span>Deposit style</span><span></span>\n      </div>\n\n      <details class=\"lrow\" data-region=\"Africa\" data-commodity=\"Nickel\" data-style=\"Laterite\">\n        <summary><span class=\"lr-region\">East Africa</span><span class=\"status live\">drill-confirmed</span><span class=\"lr-comm\">Nickel</span><span class=\"lr-style\">Supergene laterite</span><span class=\"lr-x\" aria-hidden=\"true\">+</span></summary>\n        <div class=\"lr-note\">Serpentine (Mg-OH) and ferric-oxide spectral mapping over a magnetically and radiometrically-defined ultramafic body, scored by the laterite-nickel deposit model and checked against drilling. A supergene weathering profile - limonite over saprolite over serpentinised ultramafic - with nickel enrichment in the saprolite zone. Priority targets were subsequently drill-tested and confirmed mineralized. <a class=\"textlink\" href=\"/case-studies\">Read the full flagship case &rarr;</a></div>\n      </details>\n\n      <details class=\"lrow\" data-region=\"South America\" data-commodity=\"Copper-gold\" data-style=\"Porphyry\">\n        <summary><span class=\"lr-region\">Colombia</span><span class=\"status live\">delivered &middot; 3D</span><span class=\"lr-comm\">Copper-gold</span><span class=\"lr-style\">Porphyry</span><span class=\"lr-x\" aria-hidden=\"true\">+</span></summary>\n        <div class=\"lr-note\">Concentric alteration zonation - potassic core through phyllic to a propylitic halo - mapped from multispectral imagery and magnetics, fused with the operator&rsquo;s drilling and kriged block model into a single interactive 3D deposit model. <a class=\"textlink\" href=\"/v5/eldorado-atlantis-3d.html\" target=\"_blank\" rel=\"noopener\">Fly the sanitized 3D model &rarr;</a></div>\n      </details>\n\n      <details class=\"lrow\" data-region=\"North America\" data-commodity=\"Uranium-REE\" data-style=\"Paleoplacer\">\n        <summary><span class=\"lr-region\">Northern Ontario, Canada</span><span class=\"status live\">delivered &middot; 3D</span><span class=\"lr-comm\">Uranium-REE</span><span class=\"lr-style\">Paleoplacer (QPC)</span><span class=\"lr-x\" aria-hidden=\"true\">+</span></summary>\n        <div class=\"lr-note\">A drilled uranium-rare-earth quartz-pebble-conglomerate reef rebuilt as a single-file interactive 3D model - every hole, every grade interval, the modeled reef and its untested extensions - openable on any laptop, no install. <span class=\"cap-dim\" style=\"display:inline\">Public display pending client consent.</span></div>\n      </details>\n\n      <details class=\"lrow\" data-region=\"North America\" data-commodity=\"Gold\" data-style=\"Carlin-type\">\n        <summary><span class=\"lr-region\">Nevada, USA</span><span class=\"status live\">delivered</span><span class=\"lr-comm\">Gold</span><span class=\"lr-style\">Carlin-type &amp; epithermal</span><span class=\"lr-x\" aria-hidden=\"true\">+</span></summary>\n        <div class=\"lr-note\">Run blind over a known gold district, the multi-evidence scoring independently recovered the established footprint of Carlin-type and epithermal alteration - the validation test for trusting the platform where nothing is yet proven.</div>\n      </details>\n\n      <details class=\"lrow\" data-region=\"North America\" data-commodity=\"Gold\" data-style=\"Orogenic\">\n        <summary><span class=\"lr-region\">Nevada, USA</span><span class=\"status live\">delivered</span><span class=\"lr-comm\">Gold</span><span class=\"lr-style\">Reconnaissance (orogenic)</span><span class=\"lr-x\" aria-hidden=\"true\">+</span></summary>\n        <div class=\"lr-note\">Greenfield gold reconnaissance across a large search area - multi-evidence prospectivity turning mixed-vintage imagery and geophysics into a ranked map of follow-up ground in days rather than seasons.</div>\n      </details>\n\n      <details class=\"lrow\" data-region=\"North America\" data-commodity=\"Graphite\" data-style=\"Metamorphic\">\n        <summary><span class=\"lr-region\">Quebec, Canada</span><span class=\"status dev\">active</span><span class=\"lr-comm\">Graphite</span><span class=\"lr-style\">Metamorphic flake</span><span class=\"lr-x\" aria-hidden=\"true\">+</span></summary>\n        <div class=\"lr-note\">Active flake-graphite targeting across a high-grade metamorphic host - conductive-mineral and structural mapping fused into a prospectivity surface. In progress with the operator; results will be reported here, sanitized, once reportable.</div>\n      </details>\n\n      <details class=\"lrow\" data-region=\"Africa\" data-commodity=\"Antimony\" data-style=\"Vein-hosted\">\n        <summary><span class=\"lr-region\">Morocco</span><span class=\"status live\">delivered</span><span class=\"lr-comm\">Antimony</span><span class=\"lr-style\">Vein-hosted (&plusmn; gold)</span><span class=\"lr-x\" aria-hidden=\"true\">+</span></summary>\n        <div class=\"lr-note\">A structurally-controlled antimony (&plusmn; gold) vein system targeted by fusing spectral alteration mapping with structural lineament analysis - a critical-mineral program on a metal central to supply-chain security.</div>\n      </details>\n\n      <details class=\"lrow\" data-region=\"Africa\" data-commodity=\"Lead-zinc-silver\" data-style=\"Carbonate replacement\">\n        <summary><span class=\"lr-region\">Morocco</span><span class=\"status live\">delivered</span><span class=\"lr-comm\">Lead-zinc-silver</span><span class=\"lr-style\">Carbonate replacement</span><span class=\"lr-x\" aria-hidden=\"true\">+</span></summary>\n        <div class=\"lr-note\">Carbonate-replacement lead-zinc-silver targeting in a structurally complex carbonate sequence - host-rock and alteration mapping integrated with structure to rank replacement-style targets.</div>\n      </details>\n\n      <details class=\"lrow\" data-region=\"Africa\" data-commodity=\"Tin-coltan\" data-style=\"Pegmatite\">\n        <summary><span class=\"lr-region\">DR Congo</span><span class=\"status live\">delivered</span><span class=\"lr-comm\">Tin-coltan</span><span class=\"lr-style\">Rare-metal pegmatite</span><span class=\"lr-x\" aria-hidden=\"true\">+</span></summary>\n        <div class=\"lr-note\">Rare-metal (tin-tantalum) pegmatite and associated alluvial cassiterite-coltan targeting - mapping fertile pegmatite fields and their drainage signatures across a remote terrain.</div>\n      </details>\n\n      <details class=\"lrow\" data-region=\"Africa\" data-commodity=\"Iron\" data-style=\"BIF\">\n        <summary><span class=\"lr-region\">West Africa</span><span class=\"status live\">delivered</span><span class=\"lr-comm\">Iron ore</span><span class=\"lr-style\">Banded iron formation</span><span class=\"lr-x\" aria-hidden=\"true\">+</span></summary>\n        <div class=\"lr-note\">Ground-magnetic data reprocessed into a 3D susceptibility inversion, fused with satellite iron-oxide mapping and a reassessment of legacy drilling, then carried through to geostatistical resource-estimation modeling.</div>\n      </details>\n\n      <details class=\"lrow\" data-region=\"Asia\" data-commodity=\"Zinc-lead-silver\" data-style=\"SEDEX\">\n        <summary><span class=\"lr-region\">India</span><span class=\"status live\">delivered &middot; 3D</span><span class=\"lr-comm\">Zinc-lead-silver</span><span class=\"lr-style\">SEDEX</span><span class=\"lr-x\" aria-hidden=\"true\">+</span></summary>\n        <div class=\"lr-note\">A stratiform, sediment-hosted deposit at an operating mine modeled in three dimensions, with potential resource-expansion locations identified in the surrounding subsurface as a ranked set of follow-up targets.</div>\n      </details>\n\n      <details class=\"lrow\" data-region=\"Africa\" data-commodity=\"Copper-zinc\" data-style=\"VMS\">\n        <summary><span class=\"lr-region\">Red Sea Hills</span><span class=\"status live\">due diligence</span><span class=\"lr-comm\">Copper-zinc</span><span class=\"lr-style\">VMS (polymetallic)</span><span class=\"lr-x\" aria-hidden=\"true\">+</span></summary>\n        <div class=\"lr-note\">Multi-evidence prospectivity across a volcanic-hosted massive-sulphide setting, with independent technical and commercial due-diligence modeling over a cluster of polymetallic targets - a review of client-provided material, not field verification.</div>\n      </details>\n    </div>\n\n    <p class=\"ledger-foot\">Status: <span class=\"status live\">drill-confirmed / delivered / due diligence</span> completed program &middot; <span class=\"status dev\">active</span> in progress. Locations generalized and figures withheld for confidentiality; method statements describe the pipeline, not a Mineral Resource under NI 43-101 / JORC. No grade or tonnage is stated or implied.</p>\n  </div>\n</section>\n\n<section class=\"cta-band\">\n  <div class=\"wrap\">\n    <h2>See the pipeline on your ground.</h2>\n    <p>The 48-Hour Prospect Brief tells you which deposit styles your data can support today - and what it would take to light up the rest.</p>\n    <a class=\"btn btn-gold\" href=\"/engage\">Get the 48-Hour Prospect Brief <span class=\"arr\">\u2192</span></a>\n  </div>\n</section>\n</main>\n\n<div class=\"spine-band\"><div class=\"wrap\"><p class=\"spine\">We don&rsquo;t add to your data pile - we <span class=\"hl\">resolve it into a ranked drill decision you can sign and defend.</span></p></div></div>\n\n";
