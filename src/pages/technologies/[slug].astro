---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';

import cageInImg from '../../assets/cage-in_pic1-min.jpg';
import structuralModellingImg from '../../assets/structural_modelling.png';
import geospatialImg from '../../assets/geospatial.jpg';
import aiGeoImg from '../../assets/ai-geo-identifying-prospects.png';

import cageInLanding from '../../assets/cage-in-landing.png';
import bhumi3dLanding from '../../assets/bhumi3dmapper-landing.jpg';
import batchGisLanding from '../../assets/batch-gis-loader-landing.png';
import varahmihirLanding from '../../assets/varahmihir-landing.png';
// OmniMiner placeholder — reusing existing satellite/Landsat asset until a dedicated landing screenshot is supplied
import omniminerImg from '../../assets/ai-geo-identifying-prospects.png';

const PRODUCTS = {
  'cage-in': {
    name: 'CAGE-IN Mineral Prospectivity',
    short: 'CAGE-IN',
    tagline: 'AI-driven mineral targeting from the data you already own.',
    eyebrow: 'Flagship · AI Prospectivity',
    status: 'In testing',
    statusKind: 'gold' as const,
    img: cageInImg,
    landingImg: cageInLanding,
    problemHeadline: "Your legacy data is worth millions. Re-interpreting it shouldn't take years.",
    problemBody: 'Most exploration companies and geological surveys sit on decades of satellite imagery, geochemistry, geophysics, and drill data that cost tens of millions to acquire. Manual re-interpretation across modern AI methods takes a 3–5 person team six to twelve months per project. The commodity cycle does not wait that long.',
    solutionBullets: [
      'Integrates satellite imagery with structural geology, lithology, aerogeophysics, and geochemistry — all in one pipeline',
      "Reasoning flowsheet built from experienced geologists' actual thought processes, enriched by peer-reviewed publications",
      'Geological logic stays current — new research feeds back into the model as the literature evolves',
      'Supports ASTER, Landsat 8/9, Sentinel-2, and EMIT L2A/L2B with automatic cloud, SWIR, and metadata discovery',
      'AoI-driven clipping integrated with your QGIS polygons, so processing scales to budget',
      'Outputs are prospectus-ready: ranked targets with confidence scoring, packaged for FDI attraction',
    ],
    outcome: 'A ranked portfolio of 200+ targets in weeks, not years — reasoned the way a senior exploration geologist would, then scaled across an entire license area.',
    inputs: 'Satellite imagery (ASTER, Landsat 8/9, Sentinel-2, EMIT L2A/L2B) · Structural geology · Lithology maps · Aerogeophysical surveys · Geochemistry · QGIS AoI polygon',
    outputs: 'Ranked target portfolio with confidence scoring · QGIS-loaded layers with symbology · Prospectus-ready maps',
    version: 'v0.8.0',
    deployment: 'QGIS Processing plugin',
  },
  'bhumi3dmapper': {
    name: 'Bhumi3DMapper',
    short: 'Bhumi3DMapper',
    tagline: '3D mineral prospectivity for working geologists — no command line, no Python team.',
    eyebrow: 'Production · 3D Prospectivity',
    status: 'Production ready',
    statusKind: 'green' as const,
    img: structuralModellingImg,
    landingImg: bhumi3dLanding,
    problemHeadline: "Modern 3D prospectivity scoring shouldn't require hiring a Python team.",
    problemBody: 'Multi-criterion 3D prospectivity modelling — the kind that integrates litho-structural patterns, alteration signatures, gravity gradients, magnetics, and known mineralisation envelopes — has historically meant a 6–8 week engagement with geostatisticians and a custom code pipeline per deposit. Most exploration teams have geologists, not software engineers.',
    solutionBullets: [
      'Two purpose-built models: Proximity (resource delineation, 11 criteria) and Blind (greenfield step-out, 10 criteria) in the same run',
      "Pure-Python computation core — fully tested, deposit-agnostic, runs on the geologist's laptop",
      'Five clicks: load → score → write GeoPackages → build voxel → load with colour-coded QGIS symbology',
      'Stacked 2D GeoPackages per mRL level for fast QGIS rendering; optional 3D voxel for cross-level novelty analysis',
      'Adapts in two file edits — SEDEX Pb-Zn, VMS, porphyry, epithermal — without touching the engine',
    ],
    outcome: 'A scored 3D prospect map in hours instead of months. Geologists keep ownership of the workflow. The plugin already covers 50M cells in a typical run.',
    inputs: 'Drill collars + litho/assay CSV · Gravity & magnetic susceptibility inversion TIFs · Known ore polygons (GPKG) · Project config JSON',
    outputs: 'Stacked 2D prospectivity GeoPackages (one per mRL level) · Optional .npz voxel · QGIS symbology files',
    version: 'v1.0.0',
    deployment: 'QGIS Processing plugin · QGIS 3.28+ · Qt5/Qt6 compatible',
  },
  'batch-gis-loader': {
    name: 'Batch GIS File Loader',
    short: 'Batch GIS Loader',
    tagline: 'Turn legacy data rooms into a working QGIS project in minutes.',
    eyebrow: 'Production · Data Ingestion',
    status: 'Production ready',
    statusKind: 'green' as const,
    img: geospatialImg,
    landingImg: batchGisLanding,
    problemHeadline: 'Inheriting a project means inheriting a data graveyard.',
    problemBody: 'Take over an exploration project, an M&A target, or a government data dump and you get tens of thousands of files — shapefiles, GeoPackages, GeoTIFFs, KMLs, DXFs — buried across dozens of legacy folder structures. Loading them into QGIS by hand costs analyst-weeks, breaks on broken files, and you still miss things.',
    solutionBullets: [
      'Recursive scan across the entire folder tree, with configurable max-depth',
      '20+ vector and raster formats — every file is validated before it touches QGIS',
      'Inline preview panel: CRS, geometry, feature count, extent, band info — for any file in the list',
      'Filter, search, drag-and-drop folders, and selectively group layers by FolderTree, Subfolder, or Type',
      'Progress tracking with cancellation; safe handling of permission errors and broken files',
    ],
    outcome: 'A populated, grouped, symbolised QGIS project in minutes. Production-deployed at AIRE on every new client engagement.',
    inputs: 'Any folder tree — exploration data rooms, M&A diligence packets, government data archives',
    outputs: 'QGIS layers grouped per your chosen scheme, with progress tracking and full cancellation',
    version: 'v1.0',
    deployment: 'QGIS plugin · QGIS 3.40+',
  },
  'omniminer': {
    name: 'OmniMiner',
    short: 'OmniMiner',
    tagline: 'Regional mineral reconnaissance from satellite imagery — spectral analysis for working geologists.',
    eyebrow: 'In Development · Regional Reconnaissance',
    status: 'In development',
    statusKind: 'gold' as const,
    img: omniminerImg,
    landingImg: omniminerImg,
    problemHeadline: 'Regional reconnaissance over thousands of square kilometres should not require a remote-sensing PhD.',
    problemBody: 'Mineral reconnaissance over greenfield blocks usually starts with weeks of pre-processing Landsat, Sentinel and ASTER imagery — atmospheric correction, band-ratio computation, mineral indices, classification. A solo geologist with a QGIS license cannot keep pace. OmniMiner closes that gap with a user-friendly interface to the same techniques.',
    solutionBullets: [
      'Spectral analysis pipelines for Landsat 8/9 and Sentinel-2 imagery built directly into QGIS',
      'Mineral identification via established band-ratio and PCA techniques — no Python notebook required',
      'Designed for greenfield reconnaissance — entire blocks at a time, not single AOIs',
      'Output as QGIS-loaded raster + classified vector layers, ready for further interpretation',
    ],
    outcome: 'A regional reconnaissance map in days, not weeks. Built for the field geologist who needs spectral analysis without becoming a remote-sensing specialist.',
    inputs: 'Landsat 8/9 imagery · Sentinel-2 imagery · Optional ASTER · Block-scale AoI polygon',
    outputs: 'Mineral classification rasters · Band-ratio composites · QGIS-loaded layers with symbology',
    version: 'In development',
    deployment: 'QGIS plugin · marked "Under Development" in repo',
  },
  'varahmihir': {
    name: 'Varahmihir',
    short: 'Varahmihir',
    tagline: 'AI research extraordinaire — before you spend a rupee in the field.',
    eyebrow: 'In Development · AI Researcher',
    status: 'In development',
    statusKind: 'gold' as const,
    img: aiGeoImg,
    landingImg: varahmihirLanding,
    problemHeadline: "You don't know what's already been published about your area. Until it's too expensive to care.",
    problemBody: 'Every exploration program starts with the same blind spot: what has anyone — survey agencies, academics, prior license holders, junior miners — already learned about this ground? The work exists in public-domain reports, mineral occurrence databases, and academic papers, but pulling it together takes a senior analyst three to four weeks per project and is rarely exhaustive. By the time the brief is in, the field crew is mobilised.',
    solutionBullets: [
      'Area-scoped and commodity-scoped automated research across the open web',
      'Surfaces public-domain geological survey reports, academic literature, and mineral occurrence data',
      'Synthesises findings into a structured exploration intelligence brief with full source citations',
      'Designed to front-load reconnaissance before any field, drilling, or staking cost is committed',
    ],
    outcome: "A senior analyst's three-week research deliverable, available the same day. Pre-release access is open to engaged clients.",
    inputs: 'Area polygon or place name · Mineralization style · Optional commodity focus',
    outputs: 'Structured research brief with source citations · Map-ready summary tables',
    version: 'In development',
    deployment: 'Standalone tool · roadmap includes QGIS integration',
  },
};

export function getStaticPaths() {
  return [
    { params: { slug: 'cage-in' } },
    { params: { slug: 'bhumi3dmapper' } },
    { params: { slug: 'batch-gis-loader' } },
    { params: { slug: 'omniminer' } },
    { params: { slug: 'varahmihir' } },
  ];
}

const { slug } = Astro.params;
const product = PRODUCTS[slug as keyof typeof PRODUCTS];

if (!product) {
  return Astro.redirect('/technologies');
}

const otherProducts = Object.entries(PRODUCTS)
  .filter(([s]) => s !== slug)
  .map(([s, p]) => ({ slug: s, ...p }));
---

<PageLayout
  title={`${product.name} — AI Resource Exploration`}
  description={product.tagline}
>
  <!-- Hero -->
  <section class="relative min-h-[60vh] flex items-center overflow-hidden bg-geo-slate">
    <Image
      src={product.img}
      alt=""
      aria-hidden="true"
      widths={[640, 1024, 1920]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-30"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(7,31,61,0.85) 0%, rgba(7,31,61,0.95) 100%);"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 w-full">
      <a href="/technologies" class="inline-block text-geo-secondary text-[11px] font-semibold uppercase tracking-[0.2em] hover:text-geo-gold transition-colors mb-6">
        ‹ Technologies
      </a>
      <p class="text-geo-gold text-xs font-semibold uppercase tracking-[0.25em] mb-4">{product.eyebrow}</p>
      <h1 class="font-display text-white font-bold leading-[1.05] mb-5" style="font-size: clamp(2.25rem, 5vw, 4rem);">
        {product.name}
      </h1>
      <p class="text-slate-300 text-lg md:text-xl leading-relaxed max-w-2xl mb-8">
        {product.tagline}
      </p>
      <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <a
          href="/contact"
          class="w-full sm:w-auto px-7 py-3.5 rounded bg-geo-gold text-white font-semibold text-sm uppercase tracking-wider hover:bg-amber-500 transition-colors text-center"
        >
          Book a Free Consultation →
        </a>
        <div class={`sm:ml-auto inline-flex self-start sm:self-auto px-4 py-2 bg-geo-deep/85 border text-xs font-semibold uppercase tracking-[0.18em] rounded ${product.statusKind === 'green' ? 'border-emerald-400/60 text-emerald-300' : 'border-geo-gold/60 text-geo-gold'}`}>
          {product.status}
        </div>
      </div>
    </div>
  </section>

  <!-- The Problem -->
  <section class="py-12 md:py-20 bg-geo-slate border-t border-white/5">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-reveal>
      <p class="text-geo-gold text-xs font-semibold uppercase tracking-[0.25em] mb-3">The Problem</p>
      <h2 class="font-display text-3xl md:text-5xl text-white mb-6 leading-tight">{product.problemHeadline}</h2>
      <p class="text-slate-300 text-lg leading-relaxed">{product.problemBody}</p>
    </div>
  </section>

  <!-- What we built -->
  <section class="py-12 md:py-20 bg-geo-deep">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-start">
        <div data-reveal>
          <p class="text-geo-gold text-xs font-semibold uppercase tracking-[0.25em] mb-3">What we built</p>
          <h2 class="font-display text-3xl md:text-5xl text-white mb-8 leading-tight">How {product.short} solves it</h2>
          <ul class="text-slate-300 space-y-3 text-sm md:text-base mb-8">
            {product.solutionBullets.map(b => (
              <li class="flex items-start gap-3">
                <span class="text-geo-gold mt-0.5 shrink-0">→</span>
                <span class="leading-relaxed">{b}</span>
              </li>
            ))}
          </ul>
          <div class="bg-geo-gold/8 border border-geo-gold/30 border-l-4 border-l-geo-gold rounded p-5">
            <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">The outcome</p>
            <p class="font-display italic text-white text-lg md:text-xl leading-snug">{product.outcome}</p>
          </div>
        </div>

        <div class="space-y-4" data-reveal>
          <div class="card-dark rounded-xl p-6">
            <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">Inputs</p>
            <p class="text-slate-300 text-sm leading-relaxed">{product.inputs}</p>
          </div>
          <div class="card-dark rounded-xl p-6">
            <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">Outputs</p>
            <p class="text-slate-300 text-sm leading-relaxed">{product.outputs}</p>
          </div>
          <div class="card-dark rounded-xl p-6">
            <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">Deployment</p>
            <p class="text-slate-300 text-sm leading-relaxed">{product.deployment}</p>
            <p class="text-slate-400 text-xs font-mono mt-3">Version {product.version}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Landing Page preview -->
  <section class="py-12 md:py-20 bg-geo-slate">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10" data-reveal>
        <p class="text-geo-gold text-xs font-semibold uppercase tracking-[0.25em] mb-3">The Landing Page</p>
        <h2 class="font-display text-3xl md:text-5xl text-white leading-tight">See it for yourself.</h2>
      </div>

      <div data-reveal>
        <Image
          src={product.landingImg}
          alt={`${product.name} landing page`}
          width={1800}
          class="rounded-2xl shadow-2xl shadow-black/40 w-full object-contain border border-white/10 bg-white/5"
        />
      </div>
    </div>
  </section>

  <!-- Free Consultation CTA -->
  <section class="py-14 md:py-24 bg-geo-slate text-white relative overflow-hidden border-t border-white/5">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: repeating-linear-gradient(45deg, #fff 0, #fff 1px, transparent 0, transparent 50%); background-size: 30px 30px;"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-reveal>
      <p class="text-geo-gold text-xs font-semibold uppercase tracking-[0.3em] mb-4">Free Consultation</p>
      <h2 class="font-display text-3xl md:text-5xl text-white mb-6 leading-tight">
        Curious if {product.short} fits the work you do for your clients?
      </h2>
      <p class="text-slate-300 text-base md:text-lg leading-relaxed max-w-md mx-auto mb-8">
        Book a 30-minute discovery call with Dr. Amit Tripathi. We will look at what you are delivering today, where these tools could give you leverage, and how a partnership could work — at no cost.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-5">
        <a
          href="/contact"
          class="w-full sm:w-auto px-8 py-3.5 rounded bg-geo-gold text-white font-semibold text-sm uppercase tracking-wider hover:bg-amber-500 transition-colors"
        >
          Book a Free Consultation →
        </a>
        <a
          href="/contact"
          class="w-full sm:w-auto px-8 py-3.5 rounded border border-white/20 text-white/80 font-medium text-sm hover:bg-white/10 transition-colors"
        >
          Email us a brief instead
        </a>
      </div>
      <p class="text-slate-500 text-[10px] uppercase tracking-widest">No commitments · White-label terms available · 48-hour reply</p>
    </div>
  </section>

  <!-- Cross-sell -->
  <section class="py-12 md:py-20 bg-geo-deep">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10" data-reveal>
        <p class="text-geo-gold text-xs font-semibold uppercase tracking-[0.25em] mb-3">Also from AIRE</p>
        <h3 class="font-display text-2xl md:text-3xl text-white">Other tools in the stack</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4" data-reveal>
        {otherProducts.map(p => (
          <a
            href={`/technologies/${p.slug}`}
            class="group p-6 rounded-xl border border-white/10 hover:border-geo-gold/60 bg-white/5 hover:bg-white/[0.07] transition-all duration-200"
          >
            <p class="text-geo-gold text-[10px] font-semibold uppercase tracking-[0.25em] mb-2">{p.eyebrow}</p>
            <h4 class="font-display text-lg text-white font-semibold mb-2 leading-snug">{p.short}</h4>
            <p class="text-slate-400 text-sm leading-relaxed">{p.tagline}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
