    label: 'VRAM safety margin',
    context: 'Hardware-adaptive GPU memory scheduling with automatic tile fallback on OOM.',
  },
];

const validations = [
  {
    terrain: 'Nevada, USA',
    type: 'Carlin-type Au',
    outcome: 'Blind prospectivity scoring recovered known Carlin-type district footprint from multisource spectral-structural evidence, without prior geochemical input.',
  },
  {
    terrain: 'Titiribi, Colombia',
    type: 'Porphyry Cu-Au',
    outcome: 'Method A and Method B ensemble independently ranked the principal alteration envelope — confirming porphyry structural controls at regional scale.',
