const depositModels = [
  'Porphyry Cu-Au-Mo',
  'Epithermal Au-Ag (HS + LS)',
  'IOCG',
  'Skarn Au-Ag',
  'Intrusion-Related Gold (IRG)',
  'Laterite Ni',
  'Ni Sulphide (magmatic)',
  'SEDEX polymetallic',
  'Orogenic Au (incl. Carlin-type)',
  'Metamorphic Graphite',
  'VMS',
  'Diamond Kimberlite (pipe)',
